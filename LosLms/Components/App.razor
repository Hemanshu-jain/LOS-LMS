<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Fonts are NOT loaded from Google's CDN: the CSP is self-only (no font/style host), and this is a
       LAN/offline product, so an external font would never load anyway. The CSS stacks fall back to the
       system UI font. To ship IBM Plex Sans, self-host the woff2 files under wwwroot and @font-face them. *@
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="LosLms.styles.css" />
    <HeadOutlet @rendermode="@RenderModeForRequest" />
</head>

<body>
    <Routes @rendermode="@RenderModeForRequest" />
    @* Only the interactive pages need the Blazor script. The static /account pages don't, and emitting
       it there makes the browser fetch /_framework/blazor.web.js while unauthenticated — which the
       fallback auth policy 302-redirects to the login HTML, producing a console MIME error every time. *@
    @if (RenderModeForRequest is not null)
    {
        <script src="_framework/blazor.web.js"></script>
    }
    <script src="js/download.js"></script>
    <script src="js/shortcuts.js"></script>
</body>

</html>

@code {
    // App.razor is always rendered statically, so ASP.NET Core cascades the live HttpContext into it.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Interactive everywhere except the /account pages, which must render statically.
    /// </summary>
    /// <remarks>
    /// SignInManager writes the authentication cookie through the response, and inside a SignalR
    /// circuit there is no response left to write to — the headers went out long ago. Sign-in,
    /// sign-out and change-password therefore have to be plain server-rendered form posts.
    ///
    /// .NET 9 has [ExcludeFromInteractiveRouting] and HttpContext.AcceptsInteractiveRouting() for
    /// exactly this; on .NET 8 the path check is the equivalent. Every other route keeps the global
    /// interactive mode it has always had, so none of the nine existing screens change behaviour.
    /// </remarks>
    private IComponentRenderMode? RenderModeForRequest =>
        HttpContext?.Request.Path.StartsWithSegments("/account") == true
            ? null
            : InteractiveServer;
}
