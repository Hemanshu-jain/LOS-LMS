<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Browser-tab icon. An explicit link (not just the implicit /favicon.ico guess) so it shows reliably
       even on the auth-redirected login page; the version query busts the browser's aggressive favicon cache. *@
    <link rel="icon" href="favicon.ico?v=@AssetVersion" type="image/x-icon" />
    @* Fonts are NOT loaded from Google's CDN: the CSP is self-only (no font/style host), and this is a
       LAN/offline product, so an external font would never load anyway. The CSS stacks fall back to the
       system UI font. To ship IBM Plex Sans, self-host the woff2 files under wwwroot and @font-face them. *@
    @* Version query on every static asset so a new build always fetches fresh CSS/JS. Without it
       WebView2 keeps the previous version's cached app.css after an in-place update, and any new CSS
       rule (a redesigned page, new classes) silently fails to apply until a manual hard-refresh. *@
    <link rel="stylesheet" href="app.css?v=@AssetVersion" />
    <link rel="stylesheet" href="LosLms.styles.css?v=@AssetVersion" />
    <HeadOutlet @rendermode="@RenderModeForRequest" />
</head>

<body>
    <Routes @rendermode="@RenderModeForRequest" />
    @* Only the interactive pages need the Blazor script. The static /account pages don't, and emitting
       it there makes the browser fetch /_framework/blazor.web.js while unauthenticated — which the
       fallback auth policy 302-redirects to the login HTML, producing a console MIME error every time. *@
    @if (RenderModeForRequest is not null)
    {
        @* Branded connection overlay. Blazor Server toggles the three state classes on the element with
           this exact id when the SignalR circuit drops (a server restart/update closes it with WebSocket
           1011). Without our own element here the framework shows its bare default; with it, staff see a
           calm, on-brand "we're reconnecting / the server is updating" instead of a raw error.
           Reload is a plain <a href=""> — it reloads the current URL for a fresh circuit, with no inline
           script, so the self-only Content-Security-Policy stays intact. *@
        <div id="components-reconnect-modal" class="reconnect-overlay">
            <div class="reconnect-card">
                <span class="reconnect-eyebrow">LOS/LMS</span>

                <div class="reconnect-spinner" aria-hidden="true"></div>

                <h2 class="reconnect-title reconnect-when-show">Reconnecting…</h2>
                <p class="reconnect-msg reconnect-when-show">
                    The connection dropped for a moment — the server may be restarting. We're getting you
                    back automatically. Nothing you'd saved is lost.
                </p>

                <h2 class="reconnect-title reconnect-when-failed">Still trying…</h2>
                <p class="reconnect-msg reconnect-when-failed">
                    We haven't reconnected yet. This usually clears within a few seconds while the system
                    updates — hold on, we're still trying.
                </p>

                <h2 class="reconnect-title reconnect-when-rejected">Connection closed</h2>
                <p class="reconnect-msg reconnect-when-rejected">
                    Your session ended, most likely because the server was just updated. Reload to pick up
                    where you left off — your data is safe.
                </p>
                <a href="" class="reconnect-button reconnect-when-rejected">Reload LOS/LMS</a>
            </div>
        </div>

        @* The bar Blazor shows (display toggled inline by the framework) for an unhandled client error.
           Reworded and restyled from the raw template default. *@
        <div id="blazor-error-ui">
            <span>Something went wrong. Reloading usually fixes it.</span>
            <a href="" class="blazor-error-reload">Reload</a>
        </div>

        <script src="_framework/blazor.web.js"></script>
    }
    <script src="js/download.js?v=@AssetVersion"></script>
    <script src="js/shortcuts.js?v=@AssetVersion"></script>
    <script src="js/forms.js?v=@AssetVersion"></script>
    <script src="js/media-capture.js?v=@AssetVersion"></script>
</body>

</html>

@code {
    // App.razor is always rendered statically, so ASP.NET Core cascades the live HttpContext into it.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Appended to static-asset URLs to bust the browser/WebView2 cache. The numeric version alone is
    // not enough — it stays 1.1.x across many builds, so a changed .js/.css would keep serving stale
    // from cache. Appending the build's file-write time makes the token change on every rebuild and
    // every release automatically. Computed once — nothing here can change while the process runs.
    private static readonly string AssetVersion = ComputeAssetVersion();

    private static string ComputeAssetVersion()
    {
        var assembly = System.Reflection.Assembly.GetEntryAssembly();
        var version = assembly?.GetName().Version?.ToString(3) ?? "1";
        try
        {
            var location = assembly?.Location;
            if (!string.IsNullOrEmpty(location) && File.Exists(location))
            {
                return $"{version}-{File.GetLastWriteTimeUtc(location).Ticks:x}";
            }
        }
        catch { /* fall back to the plain version below */ }
        return version;
    }

    /// <summary>
    /// Interactive everywhere except the /account pages, which must render statically.
    /// </summary>
    /// <remarks>
    /// SignInManager writes the authentication cookie through the response, and inside a SignalR
    /// circuit there is no response left to write to — the headers went out long ago. Sign-in,
    /// sign-out and change-password therefore have to be plain server-rendered form posts.
    ///
    /// .NET 9 has [ExcludeFromInteractiveRouting] and HttpContext.AcceptsInteractiveRouting() for
    /// exactly this; on .NET 8 the path check is the equivalent. Every other route keeps the global
    /// interactive mode it has always had, so none of the nine existing screens change behaviour.
    /// </remarks>
    private IComponentRenderMode? RenderModeForRequest =>
        HttpContext?.Request.Path.StartsWithSegments("/account") == true
        || HttpContext?.Request.Path.StartsWithSegments("/Error") == true
            ? null
            : InteractiveServer;
}
