@inherits LayoutComponentBase
@using LosLms.Data
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject IDbContextFactory<LosDbContext> DbFactory
@inject UpdateNotificationService Updates
@inject LicenseService License

@* Subscription freeze. Once the licence has expired the whole app is paused — this replaces every
   screen with the renewal card. A SuperAdmin can paste a renewal key here; everyone else is told to
   contact their admin. The /account pages use a different layout, so signing in to renew still works. *@
@if (License.IsFrozen)
{
    <div class="license-frozen">
        <div class="license-card">
            <h1>Subscription paused</h1>
            <p>
                This LOS/LMS subscription@(string.IsNullOrEmpty(_licClient) ? "" : $" for {_licClient}")
                ended on <strong>@License.ExpiresUtc?.ToLocalTime().ToString("d MMM yyyy")</strong>.
                The app stays paused until it is renewed — your data is safe and untouched.
            </p>

            @if (_role == "SuperAdmin")
            {
                <p class="license-hint">Paste the renewal key you were sent:</p>
                <textarea class="license-key" rows="4" @bind="_renewKey" placeholder="Paste renewal key…"></textarea>
                <button type="button" class="license-renew" disabled="@_renewing" @onclick="Renew">Renew subscription</button>
                @if (_renewMessage is not null)
                {
                    <p class="license-msg">@_renewMessage</p>
                }
            }
            else
            {
                <p class="license-hint">Please contact your administrator to renew the subscription.</p>
            }

            <a class="license-signout" href="/account/logout">Sign out</a>
        </div>
    </div>
}
else
{

@* The app bar is the only chrome this layout owns. It replaces the hardcoded
   "Credit Officer · Nashik West" chip that used to live inside the Applications Dashboard and
   appeared nowhere else — so signing out was impossible from any of the eight stage screens. *@
<AuthorizeView>
    <Authorized>
        <header class="app-bar">
            <a class="app-brand" href="/applications">LOS/LMS</a>

            @* Cosmetic only. The page itself carries [Authorize(Roles = …)], so hiding the link is
               convenience, not the control — Staff typing the URL still get the access-denied card. *@
            <AuthorizeView Roles="@TenantContext.AdminRoles" Context="admin">
                <Authorized>
                    <a class="app-nav-link" href="/admin/inbox">Admin Inbox</a>
                    <a class="app-nav-link" href="/company-setup">Company Setup</a>
                </Authorized>
            </AuthorizeView>

            @* Server-lifecycle management — Admin and SuperAdmin (the latter still has the
               system-only concerns on top). *@
            <AuthorizeView Roles="@TenantContext.AdminRoles" Context="super">
                <Authorized>
                    <a class="app-nav-link" href="/system/updates">System Updates</a>
                </Authorized>
            </AuthorizeView>

            <div class="app-user">
                <span class="app-user-name">@_displayName</span>
                <span class="app-user-role">@_role</span>
                <div class="app-avatar" role="img" aria-label="Signed-in user">
                    <Icon Name="user" Size="14" />
                </div>
                <a class="app-signout" href="/account/logout">Sign out</a>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

@* Passive reminder for the SuperAdmin — the background check found a newer release. Installing it is
   still a deliberate click-through to System Updates; this only surfaces that one exists. *@
@if (_role is "SuperAdmin" or "Admin" && Updates.UpdateAvailable && !_updateDismissed)
{
    <div class="update-banner" role="status">
        <span class="update-banner-text">
            🔔 A new version (<strong>@Updates.LatestTag</strong>) is available.
        </span>
        <a class="update-banner-action" href="/system/updates">Review &amp; install →</a>
        <button type="button" class="update-banner-dismiss" aria-label="Dismiss"
                @onclick="() => _updateDismissed = true">🗙</button>
    </div>
}

@* Approaching-expiry warning (the grace window before the freeze). Admin/SuperAdmin only — they renew. *@
@if (_role is "SuperAdmin" or "Admin" && License.State == LicenseState.ExpiringSoon)
{
    <div class="license-banner" role="status">
        ⚠️ Subscription ends in <strong>@License.DaysRemaining day@(License.DaysRemaining == 1 ? "" : "s")</strong>
        (@License.ExpiresUtc?.ToLocalTime().ToString("d MMM yyyy")). Please renew to avoid interruption.
    </div>
}

@Body

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _displayName = string.Empty;
    private string _role = string.Empty;
    private bool _updateDismissed;

    private string _licClient = string.Empty;
    private string _renewKey = string.Empty;
    private string? _renewMessage;
    private bool _renewing;

    private void Renew()
    {
        _renewing = true;
        var (ok, message) = License.ApplyRenewal(_renewKey);
        _renewMessage = message;
        _renewing = false;

        if (ok)
        {
            // No longer frozen — reload to re-enter the app cleanly.
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _licClient = License.Client ?? string.Empty;

        if (AuthenticationState is null)
        {
            return;
        }

        var user = (await AuthenticationState).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _displayName = user.FindFirst(TenantContext.DisplayNameClaim)?.Value
            ?? user.Identity.Name
            ?? string.Empty;

        // Most specific role wins — a SuperAdmin who also holds Staff should read as SuperAdmin.
        _role = user.IsInRole(TenantContext.SuperAdminRole) ? "SuperAdmin"
            : user.IsInRole(TenantContext.AdminRole) ? "Admin"
            : user.IsInRole(TenantContext.StaffRole) ? "Staff"
            : "No role";

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Backstop for the temporary-password rule. Login redirects there already; this catches
        // somebody who signs in and then types a URL to get around it. The /account pages are
        // exempt or it would redirect to itself forever. Password change takes precedence over the
        // setup gate below — a temporary credential must be replaced first.
        if (user.HasClaim(TenantContext.MustChangePasswordClaim, "true"))
        {
            if (!relative.StartsWith("account/", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/account/change-password", forceLoad: true);
            }

            return;
        }

        // Backstop for the first-run setup gate — the interactive-circuit half of the middleware in
        // Program.cs, which never sees SignalR navigations. Same rule: a company-scoped user whose
        // company setup is not complete is sent to Company Setup and can reach nothing else. SuperAdmin
        // has no company and is exempt; so are the /account and /company-setup pages themselves.
        var isSuperAdmin = user.IsInRole(TenantContext.SuperAdminRole);
        var setupExempt = relative.StartsWith("account/", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("company-setup", StringComparison.OrdinalIgnoreCase);

        if (!isSuperAdmin
            && !setupExempt
            && int.TryParse(user.FindFirst(TenantContext.CompanyIdClaim)?.Value, out var companyId))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!await CompanySetupState.IsCompleteAsync(db, companyId))
            {
                Navigation.NavigateTo("/company-setup", forceLoad: true);
            }
        }
    }
}
