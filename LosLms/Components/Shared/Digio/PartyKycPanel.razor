@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LosDbContext> DbFactory
@inject DigioKyc Kyc
@inject DigioClient Digio
@inject TenantContext Tenant
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* One party's Digio checks: PAN, Aadhaar via DigiLocker, AML. Each row is a badge plus the action; every wording comes from DigioUi/DigioKyc.
   A switched-off product shows nothing. Consent is recorded automatically on every request (signed application / DigiLocker journey). *@
@if (_loaded && _settings is not null && (_settings.PanVerify || _settings.DigiLocker || _settings.Aml || _settings.AadhaarMask))
{
    <div class="dg-panel @(Inline ? "is-inline" : null)">
        <div class="dg-panel-head"><strong>Digio checks</strong></div>

        @if (PartyId == 0)
        {
            <p class="dg-muted">Save the draft first, then run the checks.</p>
        }
        else
        {
            @if (_settings.PanVerify)
            {
                <div class="dg-row">
                    <span>PAN</span>
                    <VerifyBadge Info="@BadgeFor(null, "PAN", KycEvidenceCheck.FingerprintOf(Pan, FullName, Dob))" />
                    <VerifyButton Label="Verify PAN only" DisabledReason="@PanReason" OnClick="VerifyPanAsync" />
                    <RecheckControl CompanyId="CompanyId" ApplicationId="@ApplicationId" PartyId="PartyId" Subject="PAN" OnGranted="OnParametersSetAsync" />
                </div>
            }

            @if (_settings.DigiLocker)
            {
                <div class="dg-row">
                    <span>Aadhaar</span>
                    <VerifyBadge Info="@BadgeFor(_dl, "AADHAAR", null)" />
                    @if (!_settings.PanVerify)
                    {
                        <span>PAN</span>
                        <VerifyBadge Info="@BadgeFor(null, "PAN", KycEvidenceCheck.FingerprintOf(Pan, FullName, Dob))" />
                    }
                    <VerifyButton Label="Verify Aadhaar + PAN (DigiLocker)" DisabledReason="@DigiLockerReason" OnClick="() => StartDigiLockerAsync(true)" />
                    <VerifyButton Label="Send link to customer" DisabledReason="@DigiLockerReason" OnClick="() => StartDigiLockerAsync(false)" />
                    <RecheckControl CompanyId="CompanyId" ApplicationId="@ApplicationId" PartyId="PartyId" Subject="AADHAAR" OnGranted="OnParametersSetAsync" />
                </div>
                @if (_dl is { Status: "WaitingForCustomer" })
                {
                    <CustomerActionPanel Request="_dl" ShowId="Tenant.IsSuperAdmin" OnRefresh="RefreshDigiLockerAsync" OnCancel="CancelDigiLockerAsync"
                                         OnResend="() => OpenWaitingAsync(false)" OnOpenOnDevice="() => OpenWaitingAsync(true)" />
                }
            }

            @if (_settings.Aml)
            {
                <div class="dg-row">
                    <span>AML</span>
                    <VerifyBadge Info="@BadgeFor(null, "AML", KycEvidenceCheck.AmlFingerprintOf(FullName, Pan))" />
                    <VerifyButton Label="Screen now" DisabledReason="@AmlReason" OnClick="ScreenAmlAsync" />
                    <RecheckControl CompanyId="CompanyId" ApplicationId="@ApplicationId" PartyId="PartyId" Subject="AML" OnGranted="OnParametersSetAsync" />
                </div>
                @if (Latest("AML") is { Verdict: "Mismatch" } && (Tenant.IsAdmin || Tenant.IsSuperAdmin))
                {
                    <div class="dg-row">
                        <input class="field-input" placeholder="Why these are false positives" @bind="_amlNote" @bind:event="oninput" maxlength="300" />
                        <button type="button" class="verify-button" @onclick="AcceptAmlAsync">Accept as false positive</button>
                    </div>
                }
            }

            @if (_settings.AadhaarMask)
            {
                <div class="dg-row">
                    <span>Aadhaar masking</span>
                    <span class="dg-muted">@(Lock("AADHAAR_MASK") is { HasResult: true } m ? "Done" + (m.VerifiedOn is { } on ? " on " + on.ToLocalTime().ToString("d MMM yyyy") : "") : "Runs when the Aadhaar scan is uploaded")</span>
                    <RecheckControl CompanyId="CompanyId" ApplicationId="@ApplicationId" PartyId="PartyId" Subject="AADHAAR_MASK" OnGranted="OnParametersSetAsync" />
                </div>
            }

            @if (_message is not null)
            {
                <p class="@(_messageIsError ? "inline-error" : "dg-muted")" role="status">@_message</p>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int CompanyId { get; set; }
    [Parameter, EditorRequired] public string ApplicationId { get; set; } = "";
    /// <summary>Lays the rows straight into the parent's grid (right-hand column) so each check lines up with its input.</summary>
    [Parameter] public bool Inline { get; set; }

    [Parameter] public int PartyId { get; set; }
    [Parameter] public string? FullName { get; set; }
    [Parameter] public string? Pan { get; set; }
    [Parameter] public DateOnly? Dob { get; set; }
    [Parameter] public string? Mobile { get; set; }
    [Parameter] public bool Individual { get; set; } = true;

    /// <summary>Raised after any check changes what is on file (the page refreshes its gate and flags).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private DigioSettings? _settings;
    private List<VerificationEvidence> _evidence = new();
    private DigioRequest? _dl;
    private readonly Dictionary<string, LockStatus> _locks = new();
    private bool _production;
    private bool _loaded;
    private string? _message;
    private bool _messageIsError;
    private string _amlNote = "";

    protected override async Task OnParametersSetAsync()
    {
        await Tenant.EnsureLoadedAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.DigioSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == CompanyId);
        _production = Digio.Credentials(CompanyId)?.Production == true;
        if (PartyId > 0)
        {
            _evidence = await db.VerificationEvidence.AsNoTracking().Where(e => e.PartyId == PartyId).ToListAsync();
            _dl = await db.DigioRequests.AsNoTracking().Where(r => r.PartyId == PartyId && r.Operation == "DIGILOCKER_AADHAAR_PAN")
                .OrderByDescending(r => r.RequestedAt).FirstOrDefaultAsync();
            foreach (var subject in new[] { "PAN", "AADHAAR", "AML", "AADHAAR_MASK" })
            {
                _locks[subject] = await VerificationLock.StatusAsync(db, CompanyId, ApplicationId, PartyId, subject);
            }
        }

        _loaded = true;
    }

    private VerificationEvidence? Latest(string subject) => _evidence.Where(e => e.Subject == subject).OrderByDescending(e => e.Id).FirstOrDefault();

    private BadgeInfo BadgeFor(DigioRequest? request, string subject, string? fingerprint) =>
        DigioUi.Badge(true, false, _production, request is { Status: "WaitingForCustomer" } ? request : null, Latest(subject), fingerprint);

    private LockStatus Lock(string subject) => _locks.GetValueOrDefault(subject) ?? LockStatus.Open;

    private string? NeedsSaved => PartyId == 0 ? "Save the draft first." : null;
    private string? PanReason => Lock("PAN").Reason ?? PanInputs;
    private string? PanInputs => !System.Text.RegularExpressions.Regex.IsMatch(Pan ?? "", "^[A-Z]{5}[0-9]{4}[A-Z]$") ? "Enter a valid PAN." : string.IsNullOrWhiteSpace(FullName) ? "Enter the full name." : null;
    private string? AmlReason => Lock("AML").Reason ?? AmlInputs;
    private string? AmlInputs => string.IsNullOrWhiteSpace(FullName) ? "Enter the full name." : null;
    private string? DigiLockerReason => Lock("AADHAAR").Reason
        ?? (_dl is { Status: "WaitingForCustomer" } ? "A request is waiting for the customer." : null) ?? DigiLockerInputs;
    private string? DigiLockerInputs => string.IsNullOrWhiteSpace(FullName) ? "Enter the full name." : !System.Text.RegularExpressions.Regex.IsMatch(Mobile ?? "", "^[6-9][0-9]{9}$") ? "Enter the customer's mobile." : null;

    private async Task Done(KycOutcome o)
    {
        _message = o.Message;
        _messageIsError = o.Verdict is null or "Failed";
        await OnParametersSetAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task VerifyPanAsync() =>
        await Done(await Kyc.VerifyPanAsync(CompanyId, ApplicationId, PartyId, Pan, FullName, Dob, Individual, Tenant.UserId));

    private async Task ScreenAmlAsync() =>
        await Done(await Kyc.ScreenAmlAsync(CompanyId, ApplicationId, PartyId, FullName, Pan, Tenant.UserId));

    private async Task AcceptAmlAsync()
    {
        var ok = await Kyc.AcceptAmlAlertsAsync(CompanyId, ApplicationId, PartyId, _amlNote, Tenant.UserId ?? "");
        await Done(new(ok ? "AcceptedMismatch" : null, ok ? "Alerts accepted as false positive." : "Add a reason first."));
    }

    private async Task StartDigiLockerAsync(bool onDevice)
    {
        var o = await Kyc.StartDigiLockerAsync(CompanyId, ApplicationId, PartyId, FullName, Mobile, onDevice, Navigation.BaseUri, Tenant.UserId);
        if (o.Url is not null)
        {
            await JS.InvokeVoidAsync("open", o.Url, "_blank");
        }

        await Done(o);
    }

    /// <summary>The customer's link for the request that is already waiting: open it here, or explain that Digio already sent it. Never a new request.</summary>
    private async Task OpenWaitingAsync(bool onDevice)
    {
        if (_dl is null)
        {
            return;
        }

        if (!onDevice)
        {
            await Done(new(null, "The link was already sent to the customer. Use Open on this device, or cancel the request to start a new one."));
            return;
        }

        if (Kyc.DigiLockerLink(CompanyId, _dl, Mobile, Navigation.BaseUri) is { } url)
        {
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        else
        {
            await Done(new(null, "No link is available for this request. Cancel it to start a new one."));
        }
    }

    private async Task RefreshDigiLockerAsync()
    {
        if (_dl is not null)
        {
            await Done(await Kyc.CompleteDigiLockerAsync(CompanyId, _dl.Id));
        }
    }

    private async Task CancelDigiLockerAsync()
    {
        if (_dl is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DigioRequests.Where(r => r.Id == _dl.Id && r.Status == "WaitingForCustomer").ExecuteUpdateAsync(u => u.SetProperty(r => r.Status, "Cancelled"));
        await Done(new(null, "Request cancelled."));
    }
}
