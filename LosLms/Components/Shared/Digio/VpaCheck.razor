@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LosDbContext> DbFactory
@inject DigioKyc Kyc
@inject DigioClient Digio
@inject TenantContext Tenant

@* UPI id check next to the penny drop: does the UPI id exist, and is it the account holder's? Shown only when the company switched it on. *@
@if (_loaded && _on)
{
    <div class="dg-panel">
        <div class="dg-panel-head"><strong>UPI ID check</strong></div>
        <div class="dg-row">
            <input class="field-input" placeholder="name@bank" maxlength="100" style="max-width:260px" aria-label="UPI id" @bind="_vpa" @bind:event="oninput" />
            <VerifyBadge Info="@Badge" />
            <VerifyButton Label="Verify UPI id" DisabledReason="@Reason" OnClick="VerifyAsync" />
            <RecheckControl CompanyId="CompanyId" ApplicationId="@ApplicationId" Subject="UPI_VPA" OnGranted="OnParametersSetAsync" />
        </div>
        @if (_message is not null) { <p class="@(_error ? "inline-error" : "dg-muted")" role="status">@_message</p> }
    </div>
}

@code {
    [Parameter, EditorRequired] public int CompanyId { get; set; }
    [Parameter, EditorRequired] public string ApplicationId { get; set; } = "";

    /// <summary>The account holder's name to compare the UPI id's owner with.</summary>
    [Parameter] public string? HolderName { get; set; }

    private bool _loaded, _on, _production, _error;
    private string _vpa = "";
    private string? _message;
    private VerificationEvidence? _latest;

    private BadgeInfo Badge => DigioUi.Badge(true, false, _production, null, _latest, null);

    private LockStatus _lock = LockStatus.Open;

    private string? Reason => _lock.Reason ?? (string.IsNullOrWhiteSpace(HolderName) ? "Enter the account holder's name first." : string.IsNullOrWhiteSpace(_vpa) ? "Enter the UPI id." : null);

    protected override async Task OnParametersSetAsync()
    {
        await Tenant.EnsureLoadedAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _on = (await db.DigioSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == CompanyId))?.UpiVpa == true;
        _production = Digio.Credentials(CompanyId)?.Production == true;
        _lock = await VerificationLock.StatusAsync(db, CompanyId, ApplicationId, null, "UPI_VPA");
        _latest = await db.VerificationEvidence.AsNoTracking().Where(e => e.ApplicationId == ApplicationId && e.Subject == "UPI_VPA" && e.PartyId == null).OrderByDescending(e => e.Id).FirstOrDefaultAsync();
        _loaded = true;
    }

    private async Task VerifyAsync()
    {
        var o = await Kyc.VerifyVpaAsync(CompanyId, ApplicationId, _vpa, HolderName, Tenant.UserId);
        _message = o.Message;
        _error = o.Verdict is null or "Failed" or "Unavailable";
        await OnParametersSetAsync();
    }
}
