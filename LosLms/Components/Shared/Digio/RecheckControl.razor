@using LosLms.Data
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LosDbContext> DbFactory
@inject TenantContext Tenant

@* The Admin-only "Allow re-check" for a check that is already on file. It needs a reason, is audited (VerificationRecheck) and grants exactly
   ONE more run; the officer's button re-enables for that run only. Everyone else sees a short note while a re-check is open and nothing otherwise. *@
@if (_loaded)
{
    @if (_status.GrantOpen)
    {
        <span class="dg-muted">Re-check allowed (once).</span>
    }
    else if (_status.HasResult && _admin)
    {
        @if (!_open)
        {
            <button type="button" class="verify-button" @onclick="() => _open = true">Allow re-check</button>
        }
        else
        {
            <input class="field-input" style="max-width:260px" maxlength="300" placeholder="Why is a re-check needed?" aria-label="Reason" @bind="_reason" @bind:event="oninput" />
            <button type="button" class="verify-button" @onclick="GrantAsync">Allow one re-check</button>
            <button type="button" class="verify-button" @onclick="() => _open = false">Cancel</button>
        }
    }

    @if (_error is not null)
    {
        <span class="inline-error" role="alert">@_error</span>
    }
}

@code {
    [Parameter, EditorRequired] public int CompanyId { get; set; }
    [Parameter, EditorRequired] public string ApplicationId { get; set; } = "";
    [Parameter] public int? PartyId { get; set; }
    [Parameter, EditorRequired] public string Subject { get; set; } = "";

    /// <summary>Raised after a re-check was allowed, so the panel re-enables its button.</summary>
    [Parameter] public EventCallback OnGranted { get; set; }

    private LockStatus _status = LockStatus.Open;
    private bool _loaded, _admin, _open;
    private string? _reason, _error;

    protected override async Task OnParametersSetAsync()
    {
        await Tenant.EnsureLoadedAsync();
        _admin = Tenant.IsAdmin || Tenant.IsSuperAdmin;
        await using var db = await DbFactory.CreateDbContextAsync();
        _status = await VerificationLock.StatusAsync(db, CompanyId, ApplicationId, PartyId, Subject);
        _loaded = true;
    }

    private async Task GrantAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var name = await db.Users.AsNoTracking().Where(u => u.Id == Tenant.UserId).Select(u => u.DisplayName).FirstOrDefaultAsync();
        _error = await VerificationLock.GrantAsync(db, CompanyId, ApplicationId, PartyId, Subject, _reason, Tenant.UserId ?? "", name ?? Tenant.DisplayName);
        if (_error is null)
        {
            _open = false;
            _reason = null;
            await OnParametersSetAsync();
            await OnGranted.InvokeAsync();
        }
    }
}
