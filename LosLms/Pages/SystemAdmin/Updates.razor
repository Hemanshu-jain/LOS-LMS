@page "/system/updates"
@using System.Reflection
@using LosLms.Services
@attribute [Authorize(Roles = TenantContext.AdminRoles)]
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Config
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LicenseService License
@inject UpdateNotificationService Notifications

@* Server-lifecycle management, SuperAdmin only — not a per-company Admin concern. Checks a public
   GitHub repo's latest Release, downloads the matching build zip, and (only on an explicit second
   confirmation) signals the watchdog to swap it in. The app never overwrites its own running binaries;
   the watchdog does that, and rolls back if anything fails. *@

<PageTitle>System · LOS/LMS</PageTitle>

<div class="sys-page">
    <div class="sys-shell">

        <header class="sys-header">
            <div>
                <span class="sys-eyebrow">System</span>
                <h1 class="sys-title">System &amp; updates</h1>
            </div>
            <a class="sys-back" href="/applications">← Applications</a>
        </header>

        @* ---------- Update status: the hero ---------- *@
        <section class="sys-status sys-status--@HeroTone" aria-live="polite">
            <div class="sys-status-row">
                <span class="sys-status-glyph" aria-hidden="true">@HeroGlyph</span>
                <div class="sys-status-copy">
                    <span class="sys-status-headline">@HeroHeadline</span>
                    <span class="sys-status-sub">
                        Running version <strong>@_currentVersion</strong>@(LatestSuffix)
                    </span>
                </div>
                <button type="button" class="sys-btn" disabled="@_busy" @onclick="CheckAsync">
                    @(_checking ? "Checking…" : "Check now")
                </button>
            </div>

            @if (_result is { Checked: false })
            {
                <p class="sys-inline sys-inline--danger" role="alert">@_result.FailureReason</p>
            }

            @if (_message is not null)
            {
                <p class="sys-inline" role="status">@_message</p>
            }

            @* ---------- Update-available flow ---------- *@
            @if (_result is { Checked: true, UpdateAvailable: true })
            {
                <div class="sys-update">
                    @if (!string.IsNullOrWhiteSpace(_result.ReleaseNotes))
                    {
                        <div class="sys-notes">
                            <span class="sys-notes-label">What's new in @_result.LatestTag</span>
                            <pre class="sys-notes-body">@_result.ReleaseNotes</pre>
                        </div>
                    }

                    @if (_result.AssetDownloadUrl is null)
                    {
                        <p class="sys-inline sys-inline--danger" role="alert">
                            This release has no downloadable .zip build attached, so it can't be applied
                            automatically. Attach the publish.ps1 artifact to the GitHub Release.
                        </p>
                    }
                    else if (_downloadedZip is null)
                    {
                        <button type="button" class="sys-btn is-primary" disabled="@_busy" @onclick="DownloadAsync">
                            @(_downloading ? "Downloading…" : $"Download update ({FormatSize(_result.AssetSize)})")
                        </button>
                    }
                    else if (!_confirmApply)
                    {
                        <p class="sys-inline sys-inline--ok" role="status">Downloaded and ready to apply.</p>
                        <button type="button" class="sys-btn is-danger" @onclick="() => _confirmApply = true">
                            Apply @_result.LatestTag now…
                        </button>
                    }
                    else
                    {
                        <div class="sys-confirm" role="alertdialog" aria-label="Confirm update">
                            <p>
                                This stops the server, swaps in <strong>@_result.LatestTag</strong>, and restarts.
                                Branch staff are briefly disconnected. If the swap fails, the watchdog restores the
                                current version automatically.
                            </p>
                            <div class="sys-confirm-actions">
                                <button type="button" class="sys-btn" @onclick="() => _confirmApply = false">Cancel</button>
                                <button type="button" class="sys-btn is-danger" disabled="@_busy" @onclick="ApplyAsync">
                                    Yes, apply @_result.LatestTag
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @* ---------- Supporting facts ---------- *@
        <div class="sys-grid">

            <section class="sys-card">
                <span class="sys-card-label">Subscription</span>
                <div class="sys-card-head">
                    <h2 class="sys-card-title">Licence</h2>
                    <span class="sys-pill sys-pill--@LicenceTone">@LicenceBadge</span>
                </div>
                <p class="sys-card-body">@SubscriptionText</p>
            </section>

            <section class="sys-card">
                <span class="sys-card-label">Your app</span>
                <h2 class="sys-card-title">App address</h2>
                <p class="sys-card-body">
                    Where your staff sign in. It is fixed — share it once and it never changes.
                </p>

                @if (!string.IsNullOrWhiteSpace(_publicUrl))
                {
                    <div class="sys-address">
                        <input class="sys-address-field" readonly value="@_publicUrl"
                               @onfocus="SelectAllAsync" @ref="_urlInput" />
                        <button type="button" class="sys-btn" @onclick="CopyUrlAsync">
                            @(_copied ? "Copied ✓" : "Copy")
                        </button>
                        <a class="sys-btn" href="@_publicUrl" target="_blank" rel="noopener noreferrer">Open</a>
                    </div>
                }
                else
                {
                    <p class="sys-inline" role="status">
                        This machine is on the local network only — no public address is set yet.
                    </p>
                }
            </section>

        </div>
    </div>
</div>

@code {
    private string _currentVersion = "unknown";

    // The client's public address. Set by the launcher as LOSLMS_PUBLIC_URL; when that is absent
    // (older launcher, or LAN-only), OnAfterRender falls back to the address this page was reached on.
    private string _publicUrl = string.Empty;
    private bool _copied;
    private ElementReference _urlInput;

    private string SubscriptionText => License.State switch
    {
        LicenseState.Unlicensed => "No subscription key is present (development build) — enforcement is off.",
        LicenseState.Licensed => $"Active{ClientSuffix} — valid until {License.ExpiresUtc?.ToLocalTime():d MMM yyyy}.",
        LicenseState.ExpiringSoon =>
            $"Active{ClientSuffix} — ends in {License.DaysRemaining} day{(License.DaysRemaining == 1 ? "" : "s")} "
            + $"({License.ExpiresUtc?.ToLocalTime():d MMM yyyy}). Renew soon to avoid interruption.",
        LicenseState.Expired => $"Expired on {License.ExpiresUtc?.ToLocalTime():d MMM yyyy}.",
        _ => "",
    };

    private string ClientSuffix => string.IsNullOrEmpty(License.Client) ? "" : $" for {License.Client}";

    // ---- Presentation state (tone drives the semantic colour; no new behaviour) ----

    private string HeroTone =>
        _result is null || _checking ? "neutral"
        : !_result.Checked ? "danger"
        : _result.UpdateAvailable ? "info"
        : "ok";

    private string HeroGlyph => HeroTone switch
    {
        "ok" => "✓",
        "info" => "↑",
        "danger" => "!",
        _ => "⟳",
    };

    private string HeroHeadline =>
        _checking ? "Checking for updates…"
        : _result is null ? "Ready to check"
        : !_result.Checked ? "Couldn't check for updates"
        : _result.UpdateAvailable ? $"Update available — {_result.LatestTag}"
        : "You're on the latest version";

    // The "· latest is vX" tail, only when a successful check has something to compare against.
    private string LatestSuffix =>
        _result is { Checked: true, LatestTag: { Length: > 0 } tag } && !_result.UpdateAvailable
            ? $" · latest release {tag}"
            : "";

    private string LicenceTone => License.State switch
    {
        LicenseState.Licensed => "ok",
        LicenseState.ExpiringSoon => "warn",
        LicenseState.Expired => "danger",
        _ => "neutral",
    };

    private string LicenceBadge => License.State switch
    {
        LicenseState.Licensed => "Active",
        LicenseState.ExpiringSoon => "Expiring soon",
        LicenseState.Expired => "Expired",
        _ => "Dev build",
    };

    private string StagingFolder =>
        Path.Combine(Environment.ContentRootPath, Config["Updates:StagingFolder"] ?? "updates");

    private UpdateCheckResult? _result;
    private string? _downloadedZip;
    private bool _checking;
    private bool _downloading;
    private bool _applying;
    private bool _confirmApply;
    private string? _message;

    private bool _busy => _checking || _downloading || _applying;

    protected override async Task OnInitializedAsync()
    {
        var version = Assembly.GetEntryAssembly()?.GetName().Version;
        _currentVersion = version is null ? "unknown" : version.ToString(3);

        _publicUrl = (Config["LOSLMS_PUBLIC_URL"] ?? string.Empty).Trim();

        // Fallback when the launcher did not supply the public URL: use the host this page was reached
        // on. Taken from the request (the tunnel host once forwarded headers are honoured), never from
        // a JS eval — the CSP is script-src 'self' with no 'unsafe-eval', so eval throws and would kill
        // the circuit ("An unhandled error has occurred").
        if (string.IsNullOrWhiteSpace(_publicUrl))
        {
            var origin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
            if (!origin.Contains("127.0.0.1") && !origin.Contains("localhost"))
            {
                _publicUrl = origin;
            }
        }

        await CheckAsync();
    }

    // Selects the URL text in the focused field so it is easy to copy. A named helper, not eval,
    // because the CSP forbids eval.
    private async Task SelectAllAsync() =>
        await JS.InvokeVoidAsync("selectActiveElement");

    private async Task CopyUrlAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _publicUrl);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
        }
        catch
        {
            // Clipboard API can be blocked; the Open link and manual selection still work.
        }
    }

    private async Task CheckAsync()
    {
        _checking = true;
        _message = null;
        _downloadedZip = null;
        _confirmApply = false;

        try
        {
            var http = HttpClientFactory.CreateClient();
            _result = await UpdateService.CheckAsync(
                http, Config["Updates:GitHubOwner"], Config["Updates:GitHubRepo"], _currentVersion);

            // Keep the shared banner in step with a manual check — clears it once this shows up to date.
            if (_result.Checked)
            {
                Notifications.Set(_result);
            }
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (_result?.AssetDownloadUrl is not { } url || _result.AssetName is not { } name)
        {
            return;
        }

        _downloading = true;
        _message = null;

        try
        {
            var http = HttpClientFactory.CreateClient();
            _downloadedZip = await UpdateService.DownloadAsync(http, url, name, StagingFolder);
            _message = "Download complete.";
        }
        catch (Exception ex)
        {
            _message = $"Download failed — {ex.Message}";
        }
        finally
        {
            _downloading = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (_downloadedZip is null)
        {
            return;
        }

        _applying = true;

        try
        {
            await UpdateService.WriteApplySignal(StagingFolder, _downloadedZip);
            _confirmApply = false;
            _message =
                "Signalled the watchdog. It will stop the server, apply the update, and restart it shortly — "
                + "reconnect in a minute. If the update can't be applied, the current version is kept running.";
        }
        catch (Exception ex)
        {
            _message = $"Couldn't signal the watchdog — {ex.Message}. Is the server running under LosLms.Watchdog.exe?";
        }
        finally
        {
            _applying = false;
        }
    }

    private static string FormatSize(long bytes) =>
        bytes <= 0 ? "size unknown"
        : bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024d):0.#} MB"
        : $"{bytes / 1024d:0.#} KB";
}
