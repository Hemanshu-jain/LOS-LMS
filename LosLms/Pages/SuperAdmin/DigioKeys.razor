@page "/system/digio"
@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = TenantContext.SuperAdminRole)]
@inject IDbContextFactory<LosDbContext> DbFactory
@inject DigioClient Digio
@inject DigioWebhookHealth WebhookHealth
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IFileStore Files

<PageTitle>Digio keys · LOS/LMS</PageTitle>

@* Vendor-only. Digio issues each NBFC its own client id/secret (sandbox first, then production) and its
   own webhook secret. Secrets are write-only here: stored encrypted in the credential vault, never shown
   back. Leave a secret blank to keep the saved one. *@

<div class="dk-page">
    <div class="dk-card">
        <span class="system-label">LOS/LMS · Integrations</span>
        <h1 class="dk-title">Digio keys</h1>
        <p class="dk-muted">Per company. Until a company has keys, its Digio features stay “not configured” and nothing is sent or billed.</p>

        @if (_rows is null)
        {
            <p class="dk-muted">Loading…</p>
        }
        else
        {
            @foreach (var r in _rows)
            {
                <section class="dk-company">
                    <header>
                        <strong>@r.Name</strong> <span class="dk-code">@r.Code</span>
                        @if (r.Configured)
                        {
                            <span class="pill pill-ok">@(r.Production ? "Production" : "Sandbox") keys set</span>
                        }
                        else
                        {
                            <span class="pill">Not configured</span>
                        }
                    </header>

                    <div class="dk-grid">
                        <label>Client ID<input class="field-input" @bind="r.ClientId" autocomplete="off" /></label>
                        <label>Client secret<input class="field-input" type="password" @bind="r.ClientSecret"
                                                   placeholder="@(r.Configured ? "•••••• (unchanged)" : "")" autocomplete="new-password" /></label>
                        <label>Webhook secret<input class="field-input" type="password" @bind="r.WebhookSecret"
                                                    placeholder="@(r.HasWebhookSecret ? "•••••• (unchanged)" : "")" autocomplete="new-password" /></label>
                        <label class="dk-check"><input type="checkbox" @bind="r.Production" /> Production (untick = sandbox)</label>
                        @if (r.Production && !r.WasProduction)
                        {
                            <label>Type the company code (@r.Code) to switch to production<input class="field-input" @bind="r.ConfirmCode" autocomplete="off" /></label>
                        }
                    </div>

                    <fieldset class="dk-products">
                        <legend>Products switched on for this company</legend>
                        @foreach (var name in ProductNames)
                        {
                            <label class="dk-check"><input type="checkbox" checked="@r.Products[name]" @onchange="e => r.Products[name] = (bool)(e.Value ?? false)" /> @Label(name)</label>
                        }
                    </fieldset>

                    <fieldset class="dk-products">
                        <legend>e-NACH and agreement signature</legend>
                        <label>NACH config id (@(r.Production ? "production" : "sandbox"))
                            <input class="field-input" @bind="r.ConfigId" autocomplete="off" placeholder="@(r.ConfigMask ?? "")" /></label>
                        <label>Mandate category<input class="field-input" maxlength="10" @bind="r.Category" /></label>
                        <label>Max amount = EMI ×<input class="field-input" type="number" step="0.1" min="1" @bind="r.Multiplier" /></label>
                        <label>e-Stamp inventory tag (blank = none)<input class="field-input" maxlength="80" @bind="r.EstampTag" /></label>
                        <label>Collection account no. (@(r.Production ? "production" : "sandbox"))
                            <input class="field-input" maxlength="30" @bind="r.CorpAccount" autocomplete="off" placeholder="@(r.CorpMask ?? "")" /></label>
                        <label>Debit lead days<input class="field-input" type="number" min="1" max="7" @bind="r.LeadDays" /></label>
                        <label>Debit attempts per EMI<input class="field-input" type="number" min="1" max="5" @bind="r.MaxAttempts" /></label>
                        <label>Days before presenting again<input class="field-input" type="number" min="3" max="30" @bind="r.RepresentDays" /></label>
                        <label>Lender signature image (PNG or JPG)
                            <InputFile OnChange="e => UploadSignatureAsync(r, e)" accept=".png,.jpg,.jpeg" /></label>
                        @if (r.HasSignature) { <span class="dk-msg">Signature on file. It is stamped on each new agreement.</span> }
                    </fieldset>

                    <p class="dk-muted">Webhook URL for the Digio dashboard (Profile → Webhooks):
                        <code>@WebhookBase()webhooks/digio/@r.Id</code></p>

                    @if (r.LastReceived is not null || r.LastProblemAt is not null)
                    {
                        <p class="dk-muted">Last webhook received:
                            @(r.LastReceived?.ToLocalTime().ToString("d MMM, HH:mm") ?? "none").
                            @if (r.LastProblemAt is not null)
                            {
                                <span class="dk-problem">Last problem @r.LastProblemAt.Value.ToLocalTime().ToString("d MMM, HH:mm"): @r.Problem</span>
                            }
                        </p>
                    }

                    <button type="button" class="dk-btn" @onclick="() => Save(r)">Save</button>
                    <button type="button" class="dk-btn" disabled="@(!r.Configured || r.Testing)" @onclick="() => TestAsync(r)">@(r.Testing ? "Testing…" : "Test connection")</button>
                    @if (r.Message is not null) { <span class="dk-msg">@r.Message</span> }
                    @if (r.TestResult is not null) { <span class="dk-msg">@r.TestResult</span> }
                </section>
            }
        }
    </div>
</div>

<style>
    .dk-page { min-height: 100vh; padding: 20px 24px 40px; background: #eef1f5; }
    .dk-card { max-width: 900px; margin: 0 auto; padding: 18px 22px 26px; background: #fff; border: 1px solid #d8dee7; border-radius: 4px; }
    .dk-card .system-label { font-size: 9.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #6b7686; }
    .dk-title { margin: 4px 0 4px; font-size: 17px; font-weight: 600; color: #1d2733; }
    .dk-muted { color: #6b7686; font-size: 12.5px; margin: 6px 0; }
    .dk-company { border-top: 1px solid #e4e8ee; padding: 14px 0; }
    .dk-company header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .dk-code { font: 600 .72rem/1 ui-monospace, monospace; background: #eef1f5; border-radius: 4px; padding: 4px 6px; }
    .dk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px 14px; }
    .dk-grid label { display: flex; flex-direction: column; gap: 3px; font-size: 11.5px; font-weight: 600; color: #3a4553; }
    .dk-grid .dk-check { flex-direction: row; align-items: center; gap: 6px; font-weight: 500; }
    .dk-products { border: 1px solid #e4e8ee; margin: 10px 0; padding: 6px 12px 10px; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 4px 14px; }
    .dk-products legend { font-size: 11.5px; font-weight: 600; color: #3a4553; padding: 0 6px; }
    .dk-btn:disabled { opacity: .5; cursor: not-allowed; }
    .dk-btn { margin-right: 8px; margin-top: 6px; padding: 5px 14px; font-size: 12px; font-weight: 600; color: #fff; background: #1d2733; border: 0; border-radius: 3px; cursor: pointer; }
    .dk-btn:hover { background: #0f161e; }
    .dk-btn:focus-visible { outline: 2px solid #1d2733; outline-offset: 2px; }
    .dk-problem { color: #8a1f1f; }
    .dk-msg { margin-left: 10px; font-size: 12.5px; color: #1d6b2c; }
    .pill { display: inline-block; padding: 1px 9px; border-radius: 9px; font-size: 11px; font-weight: 600; background: #eef1f5; color: #5b6472; }
    .pill-ok { background: #e3f4e6; color: #1d6b2c; }
    code { font-size: 12px; background: #f4f6f9; padding: 1px 5px; border-radius: 3px; word-break: break-all; }
</style>

@code {
    private List<Row>? _rows;

    private sealed class Row
    {
        public int Id; public string Name = ""; public string? Code;
        public bool Configured; public bool HasWebhookSecret;
        public string ClientId = ""; public string ClientSecret = ""; public string WebhookSecret = "";
        public bool Production, WasProduction; public string? Message;
        public DateTime? LastReceived, LastProblemAt; public string? Problem;
        public string ConfirmCode = ""; public bool Testing; public string? TestResult;
        public Dictionary<string, bool> Products = new();
        public string ConfigId = "", CorpAccount = "", Category = "L001", EstampTag = ""; public string? CorpMask; public int LeadDays = 2, MaxAttempts = 2, RepresentDays = 3; public string? ConfigMask; public decimal Multiplier = 2m; public bool HasSignature;
    }

    // The DigioSettings product switches, by property name (the form and the table stay in step through this one list).
    private static readonly string[] ProductNames =
        typeof(DigioSettings).GetProperties().Where(p => p.PropertyType == typeof(bool) && p.CanWrite).Select(p => p.Name).ToArray();

    private static string Label(string name) => name switch
    {
        "PanVerify" => "PAN verify",
        "DigiLocker" => "DigiLocker (Aadhaar + PAN)",
        "AadhaarMask" => "Aadhaar masking",
        "Aml" => "AML screening",
        "IdOcr" => "ID OCR",
        "Face" => "Face match / liveness",
        "Rc" => "Vehicle RC verify",
        "Kyb" => "Business (KYB)",
        "Esign" => "e-Sign",
        "Estamp" => "e-Stamp",
        "Enach" => "e-NACH mandate",
        "Debits" => "Mandate debits",
        "Ckyc" => "CKYC",
        _ => name,
    };

    /// <summary>The address Digio posts to: PublicBaseUrl when set (the page may be open on an internal address), else this page's own.</summary>
    private string WebhookBase() => (Config["PublicBaseUrl"]?.Trim().TrimEnd('/') is { Length: > 0 } b ? b : Nav.BaseUri.TrimEnd('/')) + "/";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var companies = await db.Companies.AsNoTracking().Where(c => c.Name != "").OrderBy(c => c.Name)
            .Select(c => new { c.Id, c.Name, c.Code }).ToListAsync();

        var settings = await db.DigioSettings.AsNoTracking().ToListAsync();
        var lastWebhook = await db.DigioWebhookInbox.GroupBy(i => i.CompanyId)
            .Select(g => new { CompanyId = g.Key, At = g.Max(i => i.ReceivedAt) }).ToListAsync();

        _rows = companies.Select(c =>
        {
            var saved = Digio.Credentials(c.Id);
            var row = settings.FirstOrDefault(s => s.CompanyId == c.Id);
            return new Row
            {
                WasProduction = saved?.Production ?? false,
                Category = row?.NachCategory ?? "L001", Multiplier = row?.NachMaxMultiplier ?? 2m, EstampTag = row?.EstampTag ?? "",
                ConfigMask = Mask(saved?.Production == true ? row?.EnachConfigIdProduction : row?.EnachConfigIdSandbox),
                CorpMask = Mask(saved?.Production == true ? row?.CorporateAccountProduction : row?.CorporateAccountSandbox),
                LeadDays = row?.DebitLeadDays ?? 2, MaxAttempts = row?.MaxAttempts ?? 2, RepresentDays = row?.RepresentAfterDays ?? 3,
                HasSignature = !string.IsNullOrEmpty(row?.LenderSignaturePath),
                Products = ProductNames.ToDictionary(n => n, n => row is not null && (bool)typeof(DigioSettings).GetProperty(n)!.GetValue(row)!),
                Id = c.Id, Name = c.Name, Code = c.Code,
                Configured = saved is not null,
                HasWebhookSecret = !string.IsNullOrEmpty(saved?.WebhookSecret),
                ClientId = saved?.ClientId ?? "",
                Production = saved?.Production ?? false,
                LastReceived = lastWebhook.FirstOrDefault(w => w.CompanyId == c.Id)?.At is { } at && at > (WebhookHealth.For(c.Id).Received ?? DateTime.MinValue)
                    ? at : WebhookHealth.For(c.Id).Received,
                LastProblemAt = WebhookHealth.For(c.Id).ProblemAt,
                Problem = WebhookHealth.For(c.Id).Problem,
            };
        }).ToList();
    }

    private async Task Save(Row r)
    {
        var saved = Digio.Credentials(r.Id);
        var secret = string.IsNullOrWhiteSpace(r.ClientSecret) ? saved?.ClientSecret : r.ClientSecret.Trim();
        if (string.IsNullOrWhiteSpace(r.ClientId) || string.IsNullOrWhiteSpace(secret))
        {
            r.Message = "Client ID and client secret are both required.";
            return;
        }

        // Sandbox -> production changes what is billed and what counts as evidence, so it needs the company code typed.
        if (r.Production && !r.WasProduction && !string.Equals(r.ConfirmCode?.Trim(), r.Code, StringComparison.OrdinalIgnoreCase))
        {
            r.Message = $"Type the company code ({r.Code}) to switch to production.";
            return;
        }

        var webhook = string.IsNullOrWhiteSpace(r.WebhookSecret) ? saved?.WebhookSecret : r.WebhookSecret.Trim();
        Digio.SaveCredentials(r.Id, new DigioCredentials(r.ClientId.Trim(), secret!, webhook, r.Production));
        await SaveProductsAsync(r);
        r.WasProduction = r.Production;
        r.ConfirmCode = "";

        r.ClientSecret = r.WebhookSecret = "";
        r.Configured = true;
        r.HasWebhookSecret = !string.IsNullOrEmpty(webhook);
        r.Message = "Saved.";
    }

    private async Task SaveProductsAsync(Row r)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var row = await db.DigioSettings.FirstOrDefaultAsync(s => s.CompanyId == r.Id);
        if (row is null)
        {
            row = new DigioSettings { CompanyId = r.Id };
            db.DigioSettings.Add(row);
        }

        foreach (var (name, on) in r.Products)
        {
            typeof(DigioSettings).GetProperty(name)!.SetValue(row, on);
        }

        // A blank config id keeps the saved one. It goes to the slot of the environment being saved, so a sandbox id can't reach production.
        if (!string.IsNullOrWhiteSpace(r.ConfigId))
        {
            if (r.Production) { row.EnachConfigIdProduction = r.ConfigId.Trim(); } else { row.EnachConfigIdSandbox = r.ConfigId.Trim(); }
            r.ConfigMask = Mask(r.ConfigId.Trim());
            r.ConfigId = "";
        }

        // Like the config id: a blank keeps the saved account, and it goes to the slot of the environment being saved.
        if (!string.IsNullOrWhiteSpace(r.CorpAccount))
        {
            if (r.Production) { row.CorporateAccountProduction = r.CorpAccount.Trim(); } else { row.CorporateAccountSandbox = r.CorpAccount.Trim(); }
            r.CorpMask = Mask(r.CorpAccount.Trim());
            r.CorpAccount = "";
        }

        // Debit timing. Digio needs the request by T-1 and refuses a new debit within 3 days of a failure (DG103).
        row.DebitLeadDays = Math.Clamp(r.LeadDays, 1, 7);
        row.MaxAttempts = Math.Clamp(r.MaxAttempts, 1, 5);
        row.RepresentAfterDays = Math.Clamp(r.RepresentDays, 3, 30);
        row.NachCategory = string.IsNullOrWhiteSpace(r.Category) ? "L001" : r.Category.Trim().ToUpperInvariant();
        row.NachMaxMultiplier = r.Multiplier < 1m ? 1m : r.Multiplier;
        row.EstampTag = string.IsNullOrWhiteSpace(r.EstampTag) ? null : r.EstampTag.Trim();
        row.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
    }

    private static string? Mask(string? id) => string.IsNullOrEmpty(id) ? null : "••••" + (id.Length > 4 ? id[^4..] : id) + " (saved)";

    /// <summary>The lender's signature image, kept in the file store and stamped on each new loan agreement (the lender is not a Digio signer).</summary>
    private async Task UploadSignatureAsync(Row r, InputFileChangeEventArgs e)
    {
        const int Max = 1024 * 1024;
        try
        {
            var ext = Path.GetExtension(e.File.Name).ToLowerInvariant();
            await using var stream = e.File.OpenReadStream(Max);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (ext is not (".png" or ".jpg" or ".jpeg") || !FileSignature.Matches(ext, bytes))
            {
                r.Message = "That is not a PNG or JPG image.";
                return;
            }

            var key = $"App_Data/lender-signature/{r.Id}{(ext == ".png" ? ".png" : ".jpg")}";
            await Files.SaveAsync(key, bytes);
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.DigioSettings.FirstOrDefaultAsync(x => x.CompanyId == r.Id);
            if (row is null)
            {
                row = new DigioSettings { CompanyId = r.Id };
                db.DigioSettings.Add(row);
            }

            row.LenderSignaturePath = key;
            row.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            r.HasSignature = true;
            r.Message = "Signature saved.";
        }
        catch (IOException)
        {
            r.Message = "The image is over 1 MB.";
        }
    }

    /// <summary>A harmless authenticated call (the DigiCollect bank list). OK means the keys work; 403 means they work but the product is off.</summary>
    private async Task TestAsync(Row r)
    {
        r.Testing = true;
        r.TestResult = null;
        try
        {
            var result = await Digio.GetAsync(r.Id, null, "/v3/client/mandate/banks", null, "key test: reads the bank list");
            r.TestResult = result.Status switch
            {
                DigioStatus.Ok => "Test OK: Digio accepted the keys.",
                DigioStatus.NotConfigured => "Save the keys first.",
                DigioStatus.Paused => "Paused: " + result.Error,
                _ => "Test failed: " + (result.Error ?? "Digio did not answer."),
            };
        }
        finally
        {
            r.Testing = false;
        }
    }
}
