@page "/admin/passwords"
@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = TenantContext.SuperAdminRole)]
@inject IDbContextFactory<LosDbContext> DbFactory
@inject PasswordVault Vault

<PageTitle>Passwords · LOS/LMS</PageTitle>

@* SuperAdmin only. Reveals passwords captured in the encrypted vault (signup, invite, admin reset,
   self-change). A password never captured shows as "not captured" — it cannot be recovered from the
   hashed store. This is the vendor's cross-company view; company admins only see their own in User
   Management. *@

<div class="pw-page">
    <div class="pw-head">
        <h1>Passwords</h1>
        <p>Every account across all companies. Reveal a password only when you need it.</p>
    </div>

    @if (_rows is null)
    {
        <p class="pw-muted">Loading…</p>
    }
    else
    {
        <table class="pw-table">
            <thead>
                <tr><th>Email</th><th>Name</th><th>Company</th><th>Password</th></tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Email</td>
                        <td>@r.DisplayName</td>
                        <td>@r.Company</td>
                        <td class="pw-cell">
                            @if (_revealed.TryGetValue(r.Id, out var value))
                            {
                                <code class="pw-value">@(value ?? "— not captured —")</code>
                                <button type="button" class="pw-btn" @onclick="() => _revealed.Remove(r.Id)">Hide</button>
                            }
                            else
                            {
                                <span class="pw-mask">••••••••</span>
                                <button type="button" class="pw-btn" @onclick="() => Reveal(r.Id)">Reveal</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .pw-page { max-width: 1000px; margin: 0 auto; padding: 32px 16px 64px; }
    .pw-head h1 { font-size: 1.6rem; margin: 0 0 4px; }
    .pw-head p { color: #5b6472; margin: 0 0 24px; }
    .pw-muted { color: #5b6472; }
    .pw-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e2e6ec; border-radius: 12px; overflow: hidden; }
    .pw-table th, .pw-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid #eef1f5; font-size: .9rem; }
    .pw-table th { background: #f7f9fb; color: #5b6472; font-weight: 600; }
    .pw-table tr:last-child td { border-bottom: none; }
    .pw-cell { display: flex; align-items: center; gap: 10px; }
    .pw-value { font: 600 .9rem/1 ui-monospace, monospace; color: #1a1f29; }
    .pw-mask { letter-spacing: .12em; color: #9aa4b2; }
    .pw-btn { border: 1px solid #d3d9e0; background: #fff; border-radius: 8px; padding: 5px 12px; font-size: .8rem; cursor: pointer; }
    .pw-btn:hover { border-color: #1a1f29; }
</style>

@code {
    private List<Row>? _rows;
    private readonly Dictionary<string, string?> _revealed = new();

    private sealed record Row(string Id, string? Email, string DisplayName, string Company);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // IgnoreQueryFilters so this always lists EVERY user, independent of any company the SuperAdmin is
        // currently acting as.
        var companies = await db.Companies.ToDictionaryAsync(c => c.Id, c => c.Name);
        var users = await db.Users.IgnoreQueryFilters()
            .OrderBy(u => u.CompanyId).ThenBy(u => u.Email)
            .Select(u => new { u.Id, u.Email, u.DisplayName, u.CompanyId })
            .ToListAsync();

        _rows = users.Select(u => new Row(
            u.Id,
            u.Email,
            u.DisplayName,
            u.CompanyId is { } cid && companies.TryGetValue(cid, out var name) ? name : "—")).ToList();
    }

    private void Reveal(string userId) => _revealed[userId] = Vault.TryReveal(userId);
}
