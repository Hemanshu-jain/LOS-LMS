@page "/account/login"
@using LosLms.Data
@using LosLms.Models
@using Microsoft.AspNetCore.Identity
@attribute [AllowAnonymous]
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Sign in · LOS/LMS</PageTitle>

<RequireStaticRender />

@* Statically rendered — see App.razor. That is what gives this page a live HttpContext for the
   authentication cookie, and what makes <EditForm method="post"> a real form post with automatic
   antiforgery protection from the existing UseAntiforgery middleware. *@

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-system">LOS/LMS</span>
            <h1 class="auth-title">Sign in</h1>
            <p class="auth-sub">Loan Origination &amp; Management System</p>
        </div>

        @if (_needsSetup)
        {
            <div class="auth-setup-prompt">
                <p>No accounts exist on this system yet.</p>
                <a class="auth-setup-link" href="/account/setup">Create your administrator account →</a>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <p class="inline-error" role="alert">@_error</p>
            }

            <div class="auth-field">
                <label class="auth-label" for="login-email">Email</label>
                <InputText id="login-email" class="field-input" @bind-Value="Input.Email"
                           autocomplete="username" />
                <ValidationMessage For="() => Input.Email" class="auth-validation" />
            </div>

            <div class="auth-field">
                <label class="auth-label" for="login-password">Password</label>
                <div class="auth-password">
                    <InputText id="login-password" type="password" class="field-input"
                               @bind-Value="Input.Password" autocomplete="current-password" />
                    <button type="button" class="auth-reveal" aria-label="Show password" aria-pressed="false"
                            onclick="losTogglePassword('login-password', this)">Show</button>
                </div>
                <ValidationMessage For="() => Input.Password" class="auth-validation" />
            </div>

            <label class="auth-remember">
                <InputCheckbox @bind-Value="Input.RememberMe" />
                <span>Remember me on this device</span>
            </label>

            <button type="submit" class="auth-submit">Sign in</button>
        </EditForm>

        @* Native disclosure — no JS, which matters on this statically rendered page. There is no
           self-service reset by design: no email or SMS provider exists in this build, and for internal
           staff software an admin-driven reset is the correct control anyway. *@
        <details class="auth-forgot">
            <summary>Forgot your password?</summary>
            <p>Contact your company Admin to reset your password. They can issue you a new temporary
               password from Company Setup → User Management.</p>
        </details>
    </div>
</div>

@* Vanilla toggle for the password field. The page is statically rendered (no Blazor circuit), so a
   plain global function on a type="button" is the whole mechanism — nothing to hydrate. *@
<script>
    function losTogglePassword(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) { return; }
        var reveal = input.type === 'password';
        input.type = reveal ? 'text' : 'password';
        btn.textContent = reveal ? 'Hide' : 'Show';
        btn.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
        btn.setAttribute('aria-pressed', reveal ? 'true' : 'false');
    }
</script>

@code {
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;
    private bool _needsSetup;

    /// <summary>
    /// One message for every failure mode. A wrong password and an email that was never registered
    /// must be indistinguishable, otherwise the form becomes a way to enumerate who has an account.
    /// </summary>
    private const string FailureMessage = "Those details are not correct. Check your email and password and try again.";

    protected override async Task OnInitializedAsync()
    {
        // On a brand-new system (no admin yet) point the operator at the create-account wizard. The
        // form stays usable so the vendor master account can still sign in.
        _needsSetup = await IdentitySeeder.NeedsFirstAdminAsync(UserManager);
    }

    private async Task SignInAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: true);

        if (result.IsLockedOut)
        {
            _error = "This account is locked for a short while after too many failed attempts. Try again later.";
            return;
        }

        if (!result.Succeeded)
        {
            _error = FailureMessage;
            return;
        }

        // A deactivated account is refused after the password check, not before, so the response is
        // identical either way and reveals nothing about which accounts exist.
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null || !user.IsActive)
        {
            await SignInManager.SignOutAsync();
            _error = FailureMessage;
            return;
        }

        if (user.MustChangePassword)
        {
            Navigation.NavigateTo("/account/change-password", forceLoad: true);
            return;
        }

        // Only relative paths are honoured. An absolute one would turn the sign-in form into an open
        // redirect that could bounce a freshly authenticated user to somebody else's site.
        var destination = !string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
                ? ReturnUrl
                : "/applications";

        Navigation.NavigateTo(destination, forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
