@using LosLms.Components.Shared
@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<LosDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject TenantContext Tenant
@inject PasswordVault Vault
@inject ILogger<UsersTab> Logger

<Panel Title="Users">
    <Right>
        <button type="button" class="add-row-button" @onclick="StartInvite">+ Invite user</button>
    </Right>
    <ChildContent>
        <p class="setup-note">
            You set every user's password here, and staff cannot change it themselves — all credential
            control stays with the admin. Passwords are shown masked below; use the eye to reveal one
            briefly. Users are deactivated, never deleted, so their past actions stay attributable.
        </p>

        @if (Tenant.IsSuperAdmin)
        {
            <div class="setup-inline-add">
                <label class="setup-inline-label" for="us-company">Company</label>
                <select id="us-company" class="field-input" value="@_companyFilter"
                        @onchange="OnCompanyFilterChanged">
                    <option value="">All companies</option>
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }

        @if (_invite is not null)
        {
            <div class="setup-inline-add">
                <input class="field-input" placeholder="Display name" maxlength="100"
                       @bind="_invite.DisplayName" @bind:event="oninput" />
                <input class="field-input" type="email" placeholder="Email" maxlength="200"
                       @bind="_invite.Email" @bind:event="oninput" />
                <input class="field-input" type="text" placeholder="Password for this user" maxlength="100"
                       autocomplete="off" @bind="_invite.Password" @bind:event="oninput" />
                <select class="field-input" @bind="_invite.Role">
                    <option value="@TenantContext.StaffRole">Staff</option>
                    <option value="@TenantContext.AdminRole">Admin</option>
                </select>
                <button type="button" class="setup-save" disabled="@InviteDisabled" @onclick="InviteAsync">
                    Create account
                </button>
                <button type="button" class="setup-cancel" @onclick="() => _invite = null">Cancel</button>
            </div>
            <p class="setup-note">
                Type the password you want this user to sign in with. They use it as-is and cannot change
                it — you manage it here. It must be at least 10 characters with an upper- and lower-case
                letter, a digit and a symbol. You can reveal or reset it any time.
            </p>
        }

        @if (_resetTarget is not null)
        {
            <div class="setup-inline-add">
                <span class="setup-inline-label">Set password for @(_resetTarget.User.Email)</span>
                <input class="field-input" type="text" placeholder="Leave blank to auto-generate"
                       maxlength="100" autocomplete="off" @bind="_resetPassword" @bind:event="oninput" />
                <button type="button" class="setup-save" @onclick="ConfirmResetAsync">Set password</button>
                <button type="button" class="setup-cancel" @onclick="() => _resetTarget = null">Cancel</button>
            </div>
            <p class="setup-note">
                Type a password to hand to the user, or leave blank to auto-generate a strong one. Either
                way they sign in with it directly (no forced change), and you can reveal it below whenever
                you need it.
            </p>
        }

        @if (_error is not null)
        {
            <p class="inline-error" role="alert">@_error</p>
        }

        <div class="table-scroll">
            <table class="row-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Password</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _users)
                    {
                        var u = row;
                        <tr>
                            <td>@u.User.DisplayName</td>
                            <td>@u.User.Email</td>
                            <td>
                                @if (u.Role == TenantContext.SuperAdminRole)
                                {
                                    @* A SuperAdmin is not a company role and is not editable here. *@
                                    <span class="status-pill">SuperAdmin</span>
                                }
                                else
                                {
                                    <select class="cell-input" value="@u.Role"
                                            @onchange="e => ChangeRoleAsync(u, e.Value?.ToString())">
                                        <option value="@TenantContext.StaffRole">Staff</option>
                                        <option value="@TenantContext.AdminRole">Admin</option>
                                    </select>
                                }
                            </td>
                            <td>
                                @if (_revealed.TryGetValue(u.User.Id, out var shown))
                                {
                                    <code class="setup-credential-value">@shown</code>
                                    <button type="button" class="row-action" title="Hide now"
                                            @onclick="() => HideNow(u.User.Id)">Hide</button>
                                }
                                else if (_hasVault.Contains(u.User.Id))
                                {
                                    <span class="password-mask">••••••••</span>
                                    <button type="button" class="row-action" title="Reveal for 15 seconds"
                                            @onclick="() => RevealAsync(u.User.Id)">Show</button>
                                }
                                else
                                {
                                    <span class="field-caption">Not stored — reset to set one</span>
                                }
                            </td>
                            <td>
                                <span class="status-pill @(u.User.IsActive ? "is-active" : "is-inactive")">
                                    @(u.User.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="align-right">
                                @if (u.User.Id == Tenant.UserId)
                                {
                                    <span class="field-caption">You</span>
                                }
                                else
                                {
                                    <button type="button" class="row-action" @onclick="() => StartReset(u)">
                                        Reset password
                                    </button>
                                    <button type="button" class="row-action" @onclick="() => ToggleActiveAsync(u)">
                                        @(u.User.IsActive ? "Deactivate" : "Reactivate")
                                    </button>
                                }
                            </td>
                        </tr>
                    }

                    @if (_users.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-row">No users.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</Panel>

@code {
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private sealed record UserRow(ApplicationUser User, string Role);

    private sealed class InviteForm
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = TenantContext.StaffRole;
    }

    private List<UserRow> _users = new();
    private List<Company> _companies = new();
    private string _companyFilter = string.Empty;
    private InviteForm? _invite;
    private UserRow? _resetTarget;
    private string _resetPassword = string.Empty;
    private string? _error;

    // Which users have a viewable password on file, and the ones currently revealed (with a token so a
    // re-reveal supersedes the earlier auto-hide instead of racing it).
    private readonly HashSet<string> _hasVault = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _revealed = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Guid> _revealTokens = new(StringComparer.Ordinal);
    private bool _disposed;

    private bool InviteDisabled =>
        _invite is null
        || string.IsNullOrWhiteSpace(_invite.DisplayName)
        || string.IsNullOrWhiteSpace(_invite.Email)
        || string.IsNullOrWhiteSpace(_invite.Password);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Needed before the first render: the markup branches on IsSuperAdmin and compares UserId, and
        // the tenant is otherwise only resolved when a DbContext is created.
        await Tenant.EnsureLoadedAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        if (Tenant.IsSuperAdmin)
        {
            _companies = await db.Companies.AsNoTracking().OrderBy(c => c.Name).ToListAsync();
        }

        // The ApplicationUser query filter already restricts an Admin to their own company. The extra
        // predicate below is only for the SuperAdmin's company selector — an Admin's list is scoped by
        // the database, not by this query, so it cannot be widened by tampering with the page.
        var query = db.Users.AsNoTracking().AsQueryable();

        if (Tenant.IsSuperAdmin && int.TryParse(_companyFilter, out var companyId))
        {
            query = query.Where(u => u.CompanyId == companyId);
        }

        var users = await query.OrderBy(u => u.DisplayName).ToListAsync();

        _users = new List<UserRow>(users.Count);
        _hasVault.Clear();
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            _users.Add(new UserRow(user, roles.FirstOrDefault() ?? "—"));
            if (Vault.Has(user.Id)) { _hasVault.Add(user.Id); }
        }
    }

    private async Task OnCompanyFilterChanged(ChangeEventArgs e)
    {
        _companyFilter = e.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    }

    private void StartInvite()
    {
        _invite = new InviteForm();
        _error = null;
    }

    /// <summary>
    /// Creates a real account with the password the admin typed. There is no forced change and no
    /// self-service reset — the admin owns the credential — and it is captured in the vault so it can
    /// be revealed again from this screen.
    /// </summary>
    private async Task InviteAsync()
    {
        if (_invite is null || InviteDisabled) { return; }

        _error = null;

        var email = _invite.Email.Trim();

        if (await UserManager.FindByEmailAsync(email) is not null)
        {
            _error = "An account with that email already exists.";
            return;
        }

        // An Admin can only ever create inside their own company. A SuperAdmin has no company of their
        // own, so they must pick one first rather than silently creating an orphaned account.
        var companyId = Tenant.CompanyId
            ?? (int.TryParse(_companyFilter, out var selected) ? selected : (int?)null);

        if (companyId is null)
        {
            _error = "Select a company above before creating a user.";
            return;
        }

        var password = _invite.Password.Trim();

        var user = new ApplicationUser
        {
            UserName = email,
            Email = email,
            EmailConfirmed = true,
            DisplayName = _invite.DisplayName.Trim(),
            CompanyId = companyId,
            IsActive = true,
            MustChangePassword = false,
        };

        var result = await UserManager.CreateAsync(user, password);

        if (!result.Succeeded)
        {
            // Surfaces the policy reason (too short, no symbol, …) so the admin can fix it.
            _error = string.Join(" ", result.Errors.Select(x => x.Description));
            return;
        }

        await UserManager.AddToRoleAsync(user, _invite.Role);
        Vault.Store(user.Id, password);

        Logger.LogInformation(
            "Account created for {Email} ({Role}, company {CompanyId}) with an admin-set password.",
            email, _invite.Role, companyId);

        _invite = null;
        await LoadAsync();
        await OnSaved.InvokeAsync($"Account created for {email}");
    }

    private void StartReset(UserRow row)
    {
        _resetTarget = row;
        _resetPassword = string.Empty;
        _error = null;
    }

    /// <summary>
    /// Admin-mediated password reset — the only reset path in this build, since staff never change their
    /// own. A typed password is used as-is; left blank, a strong one is generated. Either way there is no
    /// forced change, and the password is stored in the vault so it can be revealed here later.
    /// </summary>
    /// <remarks>
    /// <c>ResetPasswordAsync</c> rotates the target's security stamp, so any session they already have
    /// open is invalidated — a reset takes effect immediately, not at the end of their session.
    /// </remarks>
    private async Task ConfirmResetAsync()
    {
        if (_resetTarget is null) { return; }

        _error = null;

        var user = await UserManager.FindByIdAsync(_resetTarget.User.Id);
        if (user is null)
        {
            _error = "That account no longer exists.";
            _resetTarget = null;
            return;
        }

        var chosen = _resetPassword.Trim();
        var password = chosen.Length > 0 ? chosen : IdentitySeeder.GenerateTemporaryPassword();

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, password);
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(x => x.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        Vault.Store(user.Id, password);

        Logger.LogInformation("Password reset for {Email} by an admin (admin-managed, no forced change).", user.Email);

        _resetTarget = null;
        _resetPassword = string.Empty;
        await LoadAsync();
        await OnSaved.InvokeAsync($"Password set for {user.Email}");
    }

    /// <summary>Reveals a stored password for 15 seconds, then re-masks it. Repeatable.</summary>
    private async Task RevealAsync(string userId)
    {
        var password = Vault.TryReveal(userId);
        if (password is null) { return; }

        var token = Guid.NewGuid();
        _revealed[userId] = password;
        _revealTokens[userId] = token;
        StateHasChanged();

        await Task.Delay(TimeSpan.FromSeconds(15));

        // Only re-mask if this reveal is still the current one — a later Show on the same row supersedes.
        if (!_disposed && _revealTokens.TryGetValue(userId, out var current) && current == token)
        {
            _revealed.Remove(userId);
            _revealTokens.Remove(userId);
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { /* circuit gone */ }
        }
    }

    private void HideNow(string userId)
    {
        _revealed.Remove(userId);
        _revealTokens.Remove(userId);
    }

    private async Task ChangeRoleAsync(UserRow row, string? role)
    {
        if (string.IsNullOrWhiteSpace(role) || role == row.Role) { return; }

        var user = await UserManager.FindByIdAsync(row.User.Id);
        if (user is null) { return; }

        var current = await UserManager.GetRolesAsync(user);
        await UserManager.RemoveFromRolesAsync(user, current);
        await UserManager.AddToRoleAsync(user, role);

        await LoadAsync();

        // Roles ride in the authentication cookie, so the change lands on their next sign-in rather
        // than mid-session. Said out loud instead of leaving an admin wondering why nothing happened.
        await OnSaved.InvokeAsync($"{user.DisplayName} is now {role} — effective at their next sign-in");
    }

    /// <summary>
    /// Soft-disable only. Deleting the row would break every foreign key that records what this person
    /// did — RCU verifier, override approver, PDD waiver, sanction signatory.
    /// </summary>
    private async Task ToggleActiveAsync(UserRow row)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Users.FirstOrDefaultAsync(u => u.Id == row.User.Id);
        if (stored is null) { return; }

        stored.IsActive = !stored.IsActive;

        // Rotating the stamp invalidates the cookie of anyone already signed in, so deactivating takes
        // effect at the next security-stamp check (SecurityStampValidator interval, 5 min) rather than
        // at the end of their 8-hour session.
        stored.SecurityStamp = Guid.NewGuid().ToString();

        await db.SaveChangesAsync();
        await LoadAsync();

        await OnSaved.InvokeAsync(
            $"{stored.DisplayName} {(stored.IsActive ? "reactivated" : "deactivated")}");
    }

    public void Dispose() => _disposed = true;
}
