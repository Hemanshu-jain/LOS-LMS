@page "/loans/{Id:int}"
@page "/loans/for/{ApplicationId}"
@using System.Globalization
@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LosDbContext> DbFactory
@inject NavigationManager Nav
@inject IFileStore Files
@inject IJSRuntime Js
@inject TenantContext Tenant
@inject DigioStatusNotifier DigioNotifier
@implements IDisposable

<PageTitle>Loan account · LOS/LMS</PageTitle>

@if (_loading)
{
    <div class="loan-page"><p class="loading-note">Loading loan account…</p></div>
}
else if (_account is null)
{
    <div class="loan-page">
        <div class="not-found">
            <h1 class="not-found-title">Loan account not found</h1>
            <p class="not-found-body">There is no loan account here. One is opened when funds are released on Post Sanction.</p>
        </div>
    </div>
}
else
{
    <div class="loan-page">
        <div class="loan-sheet">
            <a class="file-link" href="/applications/@_account.ApplicationId/post-sanction">← Application @_account.ApplicationId</a>
            <h1 class="dk-title" style="margin-top:6px;">Loan account @_account.LoanAccountNo
                <span class="dg-chip dg-@(_account.Status == "Active" ? "ok" : "off")">@_account.Status</span>
            </h1>

            <div class="loan-cards">
                <div class="loan-card"><span class="loan-label">Principal</span><strong>@Money(_account.Principal)</strong><span class="dg-muted">@_account.Roi% · @_account.Tenure months</span></div>
                <div class="loan-card"><span class="loan-label">Outstanding principal</span><strong>@Money(_standing.OutstandingPrincipal)</strong><span class="dg-muted">Paid so far @Money(_standing.TotalPaid)</span></div>
                <div class="loan-card @(_standing.DaysPastDue > 0 ? "loan-bad" : null)"><span class="loan-label">Days past due</span><strong>@_standing.DaysPastDue</strong><span class="dg-muted">Overdue @Money(_standing.OverdueAmount)</span></div>
                <div class="loan-card"><span class="loan-label">Next EMI</span><strong>@(_standing.NextDue is { } n ? Money(n.Emi) : "—")</strong><span class="dg-muted">@(_standing.NextDue is { } d ? "due " + d.DueDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture) : "all paid")</span></div>
                <div class="loan-card"><span class="loan-label">EMI mandate</span>
                    <strong>@(_mandate?.DigioState ?? _mandate?.Status ?? "None")</strong>
                    <span class="dg-muted">@(_mandate?.Umrn is { Length: > 0 } u ? "UMRN ••••" + (u.Length > 4 ? u[^4..] : u) : "no UMRN yet")</span></div>
            </div>

            <h2 class="loan-h">Repayment schedule <span class="dg-muted">(snapshot taken when funds were released)</span></h2>
            <table class="dg-signers">
                <thead><tr><th>#</th><th>Due</th><th>EMI</th><th>Principal</th><th>Interest</th><th>Status</th><th>Paid</th></tr></thead>
                <tbody>
                @foreach (var i in _account.Instalments.OrderBy(x => x.No))
                {
                    var overdue = i.DueDate < _today && i.Status is not ("Paid" or "Waived");
                    <tr class="@(overdue ? "loan-overdue" : null)">
                        <td>@i.No</td>
                        <td>@i.DueDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                        <td>@Money(i.Emi)</td>
                        <td>@Money(i.Principal)</td>
                        <td>@Money(i.Interest)</td>
                        <td><span class="dg-chip dg-@ChipFor(i.Status, overdue)">@(overdue && i.Status == "Due" ? "Overdue" : i.Status)</span></td>
                        <td>@(i.PaidAmount > 0 ? Money(i.PaidAmount) + (i.PaidOn is { } on ? " on " + on.ToString("d MMM", CultureInfo.InvariantCulture) : "") : "—")</td>
                    </tr>
                }
                </tbody>
            </table>

            <h2 class="loan-h">Debits (e-NACH presentations)</h2>
            @if (_presentations.Count == 0)
            {
                <p class="dg-muted">No debit has been presented yet. EMIs are presented automatically a couple of days before they fall due, once the mandate is registered.</p>
            }
            else
            {
                <table class="dg-signers">
                    <thead><tr><th>EMI</th><th>Attempt</th><th>Amount</th><th>Debit date</th><th>Status</th><th>Detail</th></tr></thead>
                    <tbody>
                    @foreach (var p in _presentations)
                    {
                        <tr>
                            <td>@(_account.Instalments.FirstOrDefault(i => i.Id == p.InstalmentId)?.No)</td>
                            <td>@p.Attempt</td>
                            <td>@Money(p.Amount)</td>
                            <td>@p.SettlementDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td><span class="dg-chip dg-@(p.Status == "Succeeded" ? "ok" : p.Status is "Failed" ? "bad" : p.Status is "NotPresented" or "Cancelled" ? "warn" : "info")">@p.Status</span></td>
                            <td>@(p.Status == "Succeeded" ? (p.Utr is { Length: > 0 } utr ? "UTR " + utr : "") : p.FailureReason ?? p.FailureCode)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <h2 class="loan-h">Receipts</h2>
            @if (_receipts.Count == 0)
            {
                <p class="dg-muted">No receipts yet.</p>
            }
            else
            {
                <table class="dg-signers">
                    <thead><tr><th>Receipt</th><th>Date</th><th>Source</th><th>Amount</th><th>Reference</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in _receipts)
                    {
                        <tr>
                            <td>@r.ReceiptNo</td>
                            <td>@r.ReceivedOn.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td>@r.Source</td>
                            <td>@Money(r.Amount)</td>
                            <td>@(r.Reference ?? "—")</td>
                            <td><span class="dg-chip dg-@(r.Status == "Approved" ? "ok" : "warn")">@(r.Status == "Pending" ? "Waiting for an Admin" : r.Status)</span></td>
                            <td>
                                @if (r.Status == "Approved")
                                {
                                    <button type="button" class="doc-action" @onclick="() => PdfAsync(r)">Receipt PDF</button>
                                }
                                else if (r.Status == "Pending" && _isAdmin)
                                {
                                    <button type="button" class="doc-action" @onclick="() => ApproveAsync(r)">Approve</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            @if (_account.Status == "Active")
            {
                <h2 class="loan-h">Record a cash / cheque receipt <span class="dg-muted">(an Admin approves it before it counts)</span></h2>
                <div class="loan-form">
                    <select class="field-input" aria-label="Mode" @bind="_mSource"><option>Cash</option><option>Cheque</option><option>Manual</option></select>
                    <select class="field-input" aria-label="Against EMI" @bind="_mInstalment">
                        <option value="0">On account</option>
                        @foreach (var i in _account.Instalments.Where(i => i.Status is not ("Paid" or "Waived")).OrderBy(i => i.No))
                        {
                            <option value="@i.Id">EMI @i.No · @Money(i.Emi - i.PaidAmount) due @i.DueDate.ToString("d MMM", CultureInfo.InvariantCulture)</option>
                        }
                    </select>
                    <input class="field-input" type="number" step="0.01" min="0" placeholder="Amount" aria-label="Amount" @bind="_mAmount" />
                    <input class="field-input" type="date" aria-label="Received on" @bind="_mDate" />
                    <input class="field-input" placeholder="Cheque no. / reference" aria-label="Reference" @bind="_mRef" />
                    <button type="button" class="verify-button" @onclick="RecordAsync">Record receipt</button>
                </div>
            }

            @if (_notice is not null)
            {
                <p class="inline-notice" role="status">@_notice</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? ApplicationId { get; set; }

    private static readonly CultureInfo Indian = new("en-IN");

    private bool _loading = true;
    private LoanAccount? _account;
    private EnachMandate? _mandate;
    private List<Receipt> _receipts = new();
    private LoanStanding _standing = LoanStanding.Compute([], DateOnly.MinValue);
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private List<Presentation> _presentations = new();
    private bool _isAdmin;
    private string? _notice, _mSource = "Cash", _mRef;
    private int _mInstalment;
    private decimal _mAmount;
    private DateOnly _mDate = DateOnly.FromDateTime(DateTime.Today);
    private bool _subscribed;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        if (!_subscribed)
        {
            _subscribed = true;
            DigioNotifier.Changed += OnDigioChangedAsync;
        }

        await LoadAsync();
        _loading = false;
    }

    private async Task OnDigioChangedAsync(string applicationId)
    {
        if (_account?.ApplicationId == applicationId)
        {
            await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _isAdmin = db.IsElevatedUser;
        _account = ApplicationId is { Length: > 0 }
            ? await db.LoanAccounts.AsNoTracking().Include(a => a.Instalments).FirstOrDefaultAsync(a => a.ApplicationId == ApplicationId)
            : await db.LoanAccounts.AsNoTracking().Include(a => a.Instalments).FirstOrDefaultAsync(a => a.Id == Id);
        if (_account is not null)
        {
            _mandate = await db.EnachMandates.AsNoTracking().FirstOrDefaultAsync(m => m.Id == _account.MandateId);
            _receipts = await db.Receipts.AsNoTracking().Where(r => r.LoanAccountId == _account.Id).OrderByDescending(r => r.ReceivedOn).ThenByDescending(r => r.Id).ToListAsync();
            _standing = LoanStanding.Compute(_account.Instalments, _today);
            var ids = _account.Instalments.Select(i => i.Id).ToList();
            _presentations = await db.Presentations.AsNoTracking().Where(p => ids.Contains(p.InstalmentId)).OrderBy(p => p.SettlementDate).ThenBy(p => p.Attempt).ToListAsync();
        }
    }

    private async Task RecordAsync()
    {
        _notice = null;
        if (_account is null || _mAmount <= 0)
        {
            _notice = "Enter the amount received.";
            return;
        }

        await Tenant.EnsureLoadedAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        var account = await db.LoanAccounts.FirstAsync(a => a.Id == _account.Id);
        await ReceiptService.RecordManualAsync(db, account, _mInstalment == 0 ? null : _mInstalment, _mSource ?? "Cash", _mAmount, _mDate, _mRef, Tenant.UserId);
        await db.SaveChangesAsync();
        _mAmount = 0;
        _mRef = null;
        _notice = "Recorded. It counts once an Admin approves it.";
        await LoadAsync();
    }

    private async Task ApproveAsync(Receipt r)
    {
        await Tenant.EnsureLoadedAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _notice = await ReceiptService.ApproveManualAsync(db, r.Id, Tenant.UserId ?? "", db.IsElevatedUser) ?? "Approved.";
        await LoadAsync();
    }

    private async Task PdfAsync(Receipt r)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var key = await ReceiptService.EnsurePdfAsync(db, Files, r.Id);
        if (key is not null && _account is not null)
        {
            await Js.InvokeVoidAsync("open", $"/files/{_account.ApplicationId}/receipts/{Path.GetFileName(key)}", "_blank");
        }
    }

    public void Dispose() => DigioNotifier.Changed -= OnDigioChangedAsync;

    private static string Money(decimal v) => "₹" + v.ToString("N2", Indian);

    private static string ChipFor(string status, bool overdue) =>
        status == "Paid" ? "ok" : status is "Bounced" || overdue ? "bad" : status is "PartPaid" or "Presented" ? "info" : status == "Waived" ? "warn" : "off";
}
