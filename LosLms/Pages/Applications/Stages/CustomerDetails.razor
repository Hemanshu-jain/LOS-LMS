    private static string DedupeClass(string status) => status switch
    {
        "Pass" => "pass",
        "Fail" => "fail",
        _ => "notrun",
    };

    private static string DedupeText(string status) => status switch
    {
        "Pass" => "✓ No match found — clear to proceed",
        "Fail" => "✕ Potential match found — review required",
        _ => "Not yet checked — save to run dedupe check.",
    };

    private static string FormatInr(decimal amount) => "₹" + amount.ToString("N0", IndianCulture);

    private async Task ShowToastAsync(string message)
    {
        _toast = message;

        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        // Render now, explicitly — see the matching note in LoanSecurity.razor. Without this the
        // toast is set and cleared between the only two renders an async handler triggers.
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer toast.
        }
    }
}
