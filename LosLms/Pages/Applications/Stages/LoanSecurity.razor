    }

    private async Task ShowToastAsync(string message)
    {
        _toast = message;

        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        // Render now, explicitly. ComponentBase renders an async handler exactly twice: when it
        // first yields, and when it completes. The first yield happens inside the save, before
        // _toast is set; the second happens after the delay below has already cleared it. Without
        // this call the toast is assigned and cleared without a single render ever showing it.
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer toast.
        }
    }
