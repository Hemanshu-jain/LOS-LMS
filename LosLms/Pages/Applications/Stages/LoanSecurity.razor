        entity.InsuranceProvider = form.InsuranceProvider;
        entity.PolicyNo = form.PolicyNo;
        entity.PolicyExpiry = form.PolicyExpiry;
        entity.PropertyType = form.PropertyType;
        entity.PropertyAddress = form.PropertyAddress;
        entity.Area = form.Area;
        entity.OwnershipType = form.OwnershipType;
