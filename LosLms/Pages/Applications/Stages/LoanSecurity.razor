    private static void ApplyToEntity(SecurityForm form, SecurityDetail entity)
    {
        entity.AssetType = form.AssetType;
        entity.MakeModel = form.MakeModel;
        entity.MfgYear = form.MfgYear;
        entity.RegNo = form.RegNo;
        entity.ChassisNo = form.ChassisNo;
        entity.EngineNo = form.EngineNo;
        entity.InvoiceNo = form.InvoiceNo;
        entity.InvoiceDate = form.InvoiceDate;
        entity.InvoiceValue = form.InvoiceValue;
        entity.InsuranceProvider = form.InsuranceProvider;
        entity.PolicyNo = form.PolicyNo;
        entity.PolicyExpiry = form.PolicyExpiry;
        entity.PropertyType = form.PropertyType;
        entity.PropertyAddress = form.PropertyAddress;
        entity.Area = form.Area;
        entity.OwnershipType = form.OwnershipType;
        entity.SaleDeedNo = form.SaleDeedNo;
        entity.ValuationRefNo = form.ValuationRefNo;
        entity.EncumbranceRef = form.EncumbranceRef;
        entity.AssessedValue = form.AssessedValue;
        entity.InvoiceFilePath = form.InvoiceFilePath;
        entity.InsuranceFilePath = form.InsuranceFilePath;
    }

    private async Task ShowToastAsync(string message)
    {
        _toast = message;

        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        // Render now, explicitly. ComponentBase renders an async handler exactly twice: when it
        // first yields, and when it completes. The first yield happens inside the save, before
        // _toast is set; the second happens after the delay below has already cleared it. Without
        // this call the toast is assigned and cleared without a single render ever showing it.
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer toast.
        }
    }
