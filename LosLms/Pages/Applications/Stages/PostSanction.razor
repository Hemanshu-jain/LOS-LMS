    // ---------------------------------------------------------------------
    // The release gate
    // ---------------------------------------------------------------------

    private int ClearedCount => _checklist.Count(c => c.Flag == "Cleared");

    // ─────────────────────────────────────────────────────────────────────────────
    // GATE COVERS ONLY 7 OF 9 INTENDED ITEMS. The other 2 checklist items are not
    // yet defined (see Post Sanction content brief). The moment they are added to
    // this table, this gate must require ALL rows including them — do not let this
    // silently stay at 7 once 9 exist.
    //
    // Written against every row rather than a count of 7 precisely so that adding
    // the missing items tightens the control automatically. Releasing funds is a
    // real-money action; 7-of-7 is not "done" while the brief says there are 9.
    // ─────────────────────────────────────────────────────────────────────────────
    private bool ReleaseBlocked => _checklist.Count == 0 || _checklist.Any(c => c.Flag != "Cleared");

    private string? ReleaseBlockedReason =>
        ReleaseBlocked
            ? $"{_checklist.Count - ClearedCount} checklist item(s) still pending."
            : null;

    // ---------------------------------------------------------------------
    // Sanctioned terms — Stage 7's decision, not the originally requested figures
    // ---------------------------------------------------------------------

    private decimal SanctionedAmount => _decision?.SanctionedAmount ?? 0m;

    private decimal SanctionedRoi => _decision?.SanctionedRoi ?? 0m;

    private int SanctionedTenure => _decision?.SanctionedTenure ?? 0;

    /// <summary>Stage 7's charges, waived rows excluded — the same rule the Charges tab totals use.</summary>
    private decimal ChargesTotal => _charges.Where(c => !c.Waived).Sum(c => c.Amount + c.Gst);

    /// <summary>
    /// Computed on every render, never stored. Storing it would let it drift the moment a Stage 7
    /// charge is edited or waived.
    /// </summary>
    private decimal NetDisbursement => SanctionedAmount - ChargesTotal;

    private List<AmortizationRow> Schedule =>
        _disbursement.FirstEmiDate is { } firstDue
            ? LoanMath.Schedule(SanctionedAmount, SanctionedRoi, SanctionedTenure, firstDue)
            : new List<AmortizationRow>();

    // ---------------------------------------------------------------------
    // Editing
    // ---------------------------------------------------------------------

    private void GoToDisbursementTab() => _activeTab = DisbursementTab;

    /// <summary>Clearing a flag stamps the server date; reverting to Pending clears it again.</summary>
    private void SetFlag(PostSanctionChecklist row, string? flag)
    {
        row.Flag = string.IsNullOrWhiteSpace(flag) ? "Pending" : flag;
        row.ClearedOn = row.Flag == "Cleared" ? DateOnly.FromDateTime(DateTime.Now) : null;
    }

    /// <summary>Moving a PDD off Waived drops the approver — an approval cannot outlive its waiver.</summary>
    private void SetPddStatus(Pdd row, string? status)
    {
        row.Status = string.IsNullOrWhiteSpace(status) ? "Open" : status;

        if (row.Status != "Waived")
        {
            row.WaivedByOfficerId = null;
        }
    }

    // ---------------------------------------------------------------------
    // Uploads — same pattern as every other screen: outside wwwroot, served by /files
    // ---------------------------------------------------------------------

    private async Task UploadAsync(InputFileChangeEventArgs e, string slot)
    {
        _uploadError = null;
        var file = e.File;

        if (file is null || _application is null)
        {
            return;
        }

        if (file.Size > MaxUploadBytes)
        {
            _uploadError = $"File is too large. Maximum {MaxUploadBytes / (1024 * 1024)} MB.";
            return;
        }

        var extension = Path.GetExtension(file.Name);
        if (!AllowedExtensions.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            _uploadError = "Only PDF, JPG or PNG files are accepted.";
            return;
        }

        byte[] bytes;
        await using (var stream = file.OpenReadStream(MaxUploadBytes))
        {
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }

        var folder = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "uploads",
            _application.Id, "postsanction");
        Directory.CreateDirectory(folder);

        var fileName = $"{slot}-{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), bytes);

        var relativePath = Path.Combine("App_Data", "uploads", _application.Id, "postsanction", fileName);

        // Persist everything the officer has typed before reloading, or an upload would discard it —
        // the lesson from the Stage 5 report upload.
        await using var db = await DbFactory.CreateDbContextAsync();
        await PersistAsync(db);

        switch (slot)
        {
            case MemoSlot:
                (await CurrentDisbursementAsync(db)).MemoFilePath = relativePath;
                break;
            case InsuranceSlot:
                (await CurrentDisbursementAsync(db)).InsuranceFilePath = relativePath;
                break;
            case GeneralDocSlot:
                (await CurrentDisbursementAsync(db)).GeneralDocFilePath = relativePath;
                break;
            case ReceiptSlot:
                var record = await db.DownPaymentRecords.FirstAsync(d => d.ApplicationId == ApplicationId);
                record.ReceiptFilePath = relativePath;
                break;
        }

        await db.SaveChangesAsync();
        await LoadAsync(db);

        await ShowToastAsync("File uploaded");
    }

    private Task<Disbursement> CurrentDisbursementAsync(LosDbContext db) =>
        db.Disbursements.FirstAsync(d => d.ApplicationId == ApplicationId);

    private static string? FileNameOf(string? relativePath) =>
        string.IsNullOrWhiteSpace(relativePath) ? null : Path.GetFileName(relativePath);

    /// <summary>Maps a stored relative path onto the guarded /files endpoint built in Stage 4.</summary>
    private string UrlFor(string relativePath) =>
        $"/files/{ApplicationId}/postsanction/{Path.GetFileName(relativePath)}";

    // ---------------------------------------------------------------------
    // Release funds
    // ---------------------------------------------------------------------

    private async Task ReleaseFundsAsync()
    {
        // Server-side gate. The sub-header already disables the button, but that is UX — a crafted
        // event or a stale circuit must not get past it. One shared check, never re-implemented.
        await using (var gateDb = await DbFactory.CreateDbContextAsync())
        {
            if (!(await GateCheckService.CanAdvanceAsync(gateDb, ApplicationId)).CanAdvance)
            {
                return;
            }
        }
        // The button carries a real disabled attribute; this repeats the check so a crafted request
        // cannot release funds against an unfinished checklist.
        if (ReleaseBlocked || _application is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        await PersistAsync(db);

        var application = await db.Applications.FirstAsync(a => a.Id == ApplicationId);
        application.Disbursed = true;

        // CurrentStage deliberately stays at 8 — this is the final stage, there is no Stage 9.

        await db.SaveChangesAsync();

        _disbursed = true;
        await ShowToastAsync("Funds released");
    }

    // ---------------------------------------------------------------------
    // Persistence
    // ---------------------------------------------------------------------

    private async Task PersistAsync(LosDbContext db)
    {
        if (_application is null)
        {
            return;
        }

        var disbursement = await db.Disbursements.FirstOrDefaultAsync(d => d.ApplicationId == ApplicationId);
        if (disbursement is null)
        {
            disbursement = new Disbursement { ApplicationId = ApplicationId };
            db.Disbursements.Add(disbursement);
        }

        disbursement.Type = _disbursement.Type;
        disbursement.BeneficiaryName = _disbursement.BeneficiaryName;
        disbursement.BeneficiaryAccount = _disbursement.BeneficiaryAccount;
        disbursement.PaymentMode = _disbursement.PaymentMode;
        disbursement.ValueDate = _disbursement.ValueDate;
        disbursement.Utr = _disbursement.Utr;
        disbursement.FirstEmiDate = _disbursement.FirstEmiDate;

        var enach = await db.EnachMandates.FirstOrDefaultAsync(m => m.ApplicationId == ApplicationId);
        if (enach is null)
        {
            enach = new EnachMandate { ApplicationId = ApplicationId };
            db.EnachMandates.Add(enach);
        }

        enach.Umrn = _enach.Umrn;
        enach.Status = _enach.Status;
        enach.DebitDate = _enach.DebitDate;
        enach.LinkedAccount = _enach.LinkedAccount;
        CopyMandateFlow(_enach, enach);

        var snach = await db.SecurityNachMandates.FirstOrDefaultAsync(m => m.ApplicationId == ApplicationId);
        if (snach is null)
        {
            snach = new SecurityNachMandate { ApplicationId = ApplicationId };
            db.SecurityNachMandates.Add(snach);
        }

        snach.Umrn = _snach.Umrn;
        snach.Status = _snach.Status;
        snach.MandateHolder = _snach.MandateHolder;
        CopyMandateFlow(_snach, snach);

        var downPayment = await db.DownPaymentRecords.FirstOrDefaultAsync(d => d.ApplicationId == ApplicationId);
        if (downPayment is null)
        {
            downPayment = new DownPaymentRecord { ApplicationId = ApplicationId };
            db.DownPaymentRecords.Add(downPayment);
        }

        downPayment.AmountReceived = _downPayment.AmountReceived;
        downPayment.ReceiptNo = _downPayment.ReceiptNo;
        downPayment.ReceivedDate = _downPayment.ReceivedDate;

        // Checklist and PDD rows are seeded, never added or removed by the officer, so these are
        // straight field updates rather than the insert/update/delete diff the earlier stages need.
        var storedChecklist = await db.PostSanctionChecklists
            .Where(c => c.ApplicationId == ApplicationId).ToListAsync();

        foreach (var row in _checklist)
        {
            var target = storedChecklist.FirstOrDefault(c => c.Id == row.Id);
            if (target is null)
            {
                continue;
            }

            target.Flag = row.Flag;
            target.ClearedOn = row.ClearedOn;
            target.Remarks = row.Remarks;
        }

        var storedPdds = await db.Pdds.Where(p => p.ApplicationId == ApplicationId).ToListAsync();

        foreach (var row in _pdds)
        {
            var target = storedPdds.FirstOrDefault(p => p.Id == row.Id);
            if (target is null)
            {
                continue;
            }

            target.Status = row.Status;
            target.WaivedByOfficerId = row.WaivedByOfficerId;
        }
    }

