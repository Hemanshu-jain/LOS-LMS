    // Sanctioned terms — Stage 7's decision, not the originally requested figures
    // ---------------------------------------------------------------------

    private decimal SanctionedAmount => _decision?.SanctionedAmount ?? 0m;

    private decimal SanctionedRoi => _decision?.SanctionedRoi ?? 0m;

    private int SanctionedTenure => _decision?.SanctionedTenure ?? 0;

    /// <summary>Stage 7's charges, waived rows excluded — the same rule the Charges tab totals use.</summary>
    private decimal ChargesTotal => _charges.Where(c => !c.Waived).Sum(c => c.Amount + c.Gst);

    /// <summary>
    /// Computed on every render, never stored. Storing it would let it drift the moment a Stage 7
    /// charge is edited or a trade advance is entered.
    /// </summary>
    private decimal NetDisbursement => SanctionedAmount - ChargesTotal - (_disbursement.TradeAdvance ?? 0m);

    private List<AmortizationRow> Schedule =>
        _disbursement.FirstEmiDate is { } firstDue
            ? LoanMath.Schedule(
                SanctionedAmount, SanctionedRoi, SanctionedTenure, firstDue,
                _disbursement.FirstEmiOverride, _disbursement.EmiRoundedTo)
            : new List<AmortizationRow>();

    /// <summary>
    /// The preferred EMI day of month (5 / 10). Choosing one derives the first EMI date as the next
    /// occurrence of that day on/after the value date (today if none), so every instalment lands on it.
    /// </summary>
    private string EmiDayChoice
    {
        get => _disbursement.EmiDayOfMonth?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        set
        {
            _disbursement.EmiDayOfMonth = int.TryParse(value, out var d) ? d : (int?)null;
            if (_disbursement.EmiDayOfMonth is { } day)
            {
                var anchor = _disbursement.ValueDate ?? DateOnly.FromDateTime(DateTime.Today);
                _disbursement.FirstEmiDate = NextDayOfMonth(anchor, day);
            }
        }
    }

    /// <summary>The first date on or after <paramref name="from"/> that falls on <paramref name="day"/>,
    /// clamped to the month's length (a 31 becomes the 30th in a 30-day month).</summary>
    private static DateOnly NextDayOfMonth(DateOnly from, int day)
    {
        var thisMonthDay = Math.Min(day, DateTime.DaysInMonth(from.Year, from.Month));
        var candidate = new DateOnly(from.Year, from.Month, thisMonthDay);
        if (candidate > from) { return candidate; }

        var next = from.AddMonths(1);
        var nextDay = Math.Min(day, DateTime.DaysInMonth(next.Year, next.Month));
        return new DateOnly(next.Year, next.Month, nextDay);
    }

    private static string Ordinal(int n) => n switch
    {
        1 or 21 or 31 => $"{n}st",
        2 or 22 => $"{n}nd",
        3 or 23 => $"{n}rd",
        _ => $"{n}th",
    };

    /// <summary>Days a due date is past today; 0 when it is today or in the future.</summary>
    private static int DaysOverdue(DateOnly? dueDate)
    {
        if (dueDate is not { } due) { return 0; }
        var days = DateOnly.FromDateTime(DateTime.Today).DayNumber - due.DayNumber;
        return days > 0 ? days : 0;
    }

    private int OverdueCount => Schedule.Count(r => DaysOverdue(r.DueDate) > 0);

    private int MaxDaysOverdue => Schedule.Select(r => DaysOverdue(r.DueDate)).DefaultIfEmpty(0).Max();

    /// <summary>The standard computed EMI, shown as the First-EMI field's placeholder.</summary>
    private decimal StandardEmi => LoanMath.Emi(SanctionedAmount, SanctionedRoi, SanctionedTenure);

    /// <summary>
    /// The first month's instalment as the schedule actually renders it (override if set, else
    /// standard). Used by the welcome letter and SMS so their EMI matches what the borrower will pay.
    /// </summary>
    private decimal FirstMonthEmi
    {
        get
        {
            var schedule = Schedule;
            return schedule.Count > 0 ? schedule[0].Emi : (_disbursement.FirstEmiOverride ?? StandardEmi);
        }
    }

