    private int ClearedCount => _checklist.Count(c => c.Flag == "Cleared");

    // Release is allowed once every item on the branch disbursement checklist reads Cleared. An empty
    // checklist never releases — a file must have its checklist created before any funds move.
    private bool ReleaseBlocked =>
        _checklist.Count == 0 || _checklist.Any(c => c.Flag != "Cleared");

    private string? ReleaseBlockedReason =>
        !ReleaseBlocked
            ? null
            : _checklist.Count == 0
                ? "The disbursement checklist has not been created yet."
                : $"{_checklist.Count - ClearedCount} checklist item(s) still pending.";

