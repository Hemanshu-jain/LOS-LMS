    /// <summary>
    /// Sends the generated agreement to Digio for Aadhaar e-Sign. On acceptance the status becomes 'Sent';
    /// never 'Signed' — only Digio's verified webhook may set that.
    /// </summary>
    private async Task SendForEsignAsync()
    {
        _esignNotice = null;

        if (_application is null || string.IsNullOrWhiteSpace(_disbursement.AgreementFilePath))
        {
            _esignNotice = "Generate the agreement first.";
            return;
        }

        if (_disbursement.AgreementEsignStatus is "Sent" or "Signed")
        {
            _esignNotice = $"Already {_disbursement.AgreementEsignStatus.ToLowerInvariant()} — not sent again.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var applicant = await db.Parties.AsNoTracking()
            .FirstOrDefaultAsync(p => p.ApplicationId == ApplicationId && p.PartyType == "Applicant");
        var signer = !string.IsNullOrWhiteSpace(applicant?.Mobile) ? applicant.Mobile : applicant?.Email;
        if (string.IsNullOrWhiteSpace(signer))
        {
            _esignNotice = "Add the applicant's mobile or email on Customer Details first — the signing link goes there.";
            return;
        }

        var fullPath = Path.Combine(HostEnvironment.ContentRootPath, _disbursement.AgreementFilePath);
        if (!File.Exists(fullPath))
        {
            _esignNotice = "The agreement file is missing — generate it again.";
            return;
        }

        var result = await EsignService.DispatchAsync(
            Digio, _application.CompanyId, ApplicationId, fullPath, signer, applicant!.FullName);

        if (result.Status != DigioStatus.Ok || result.Str("id") is not { } documentId)
        {
            _esignNotice = result.Status switch
            {
                DigioStatus.NotConfigured => EsignService.Unavailable,
                _ => result.Error ?? "Digio did not accept the document.",
            };
            return;
        }

        // Make sure the row exists with the current fields, then record the dispatch itself.
        await PersistAsync(db);
        await db.SaveChangesAsync();
        var row = await db.Disbursements.FirstAsync(d => d.ApplicationId == ApplicationId);
        row.AgreementEsignStatus = _disbursement.AgreementEsignStatus = "Sent";
        row.EsignDocumentId = _disbursement.EsignDocumentId = documentId;
        await db.SaveChangesAsync();
        _esignNotice = $"Sent to the applicant ({signer}) for Aadhaar e-Sign.";
    }

    /// <summary>Writes generated PDF bytes to the guarded uploads folder, same shape as an upload.</summary>
    private async Task<string> WriteGeneratedAsync(byte[] bytes, string kind)
    {
        var folder = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "uploads",
            _application!.Id, "postsanction");
        Directory.CreateDirectory(folder);

        var fileName = $"{kind}-{Guid.NewGuid():N}.pdf";
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), bytes);

        return Path.Combine("App_Data", "uploads", _application.Id, "postsanction", fileName);
    }

    /// <summary>
    /// Writes the welcome letter with a human-readable name — "{Customer}-{date}-welcomeletter.pdf" —
    /// rather than a random id. It goes to the guarded uploads folder so the in-app link works, and a
    /// copy is filed under App_Data/welcome-letters/ so every letter can be found on disk without
    /// opening the app.
    /// </summary>
    private async Task<string> WriteWelcomeLetterAsync(byte[] bytes)
    {
        var fileName = $"{SafeFileName(_application!.CustomerName)}-{DateTime.Today:yyyy-MM-dd}-welcomeletter.pdf";

        var served = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "uploads",
            _application.Id, "postsanction");
        Directory.CreateDirectory(served);
        await File.WriteAllBytesAsync(Path.Combine(served, fileName), bytes);

        // A browsable archive of every welcome letter, outside the per-application upload tree.
        var archive = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "welcome-letters");
        Directory.CreateDirectory(archive);
        await File.WriteAllBytesAsync(Path.Combine(archive, fileName), bytes);

        return Path.Combine("App_Data", "uploads", _application.Id, "postsanction", fileName);
    }

    /// <summary>A filename-safe form of the customer name: letters, digits and single hyphens only.</summary>
    private static string SafeFileName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return "Customer"; }

        var cleaned = new string(name.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        while (cleaned.Contains("--")) { cleaned = cleaned.Replace("--", "-"); }
        return cleaned.Trim('-') is { Length: > 0 } trimmed ? trimmed : "Customer";
    }

