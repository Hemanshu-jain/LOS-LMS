    // ---------------------------------------------------------------------
    // Uploads — same pattern as every other screen: outside wwwroot, served by /files
    // ---------------------------------------------------------------------

    private async Task UploadAsync(InputFileChangeEventArgs e, string slot)
    {
        _uploadError = null;
        var file = e.File;

        if (file is null || _application is null)
        {
            return;
        }

        if (file.Size > MaxUploadBytes)
        {
            _uploadError = $"File is too large. Maximum {MaxUploadBytes / (1024 * 1024)} MB.";
            return;
        }

        var extension = Path.GetExtension(file.Name);
        if (!AllowedExtensions.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            _uploadError = "Only PDF, JPG or PNG files are accepted.";
            return;
        }

        byte[] bytes;
        await using (var stream = file.OpenReadStream(MaxUploadBytes))
        {
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }

        if (!FileSignature.Matches(extension, bytes))
        {
            _uploadError = "This file's contents don't match its type. Upload a genuine PDF, JPG or PNG.";
            return;
        }

        var folder = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "uploads",
            _application.Id, "postsanction");
        Directory.CreateDirectory(folder);

        var fileName = $"{slot}-{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), bytes);

        var relativePath = Path.Combine("App_Data", "uploads", _application.Id, "postsanction", fileName);

        // Persist everything the officer has typed before reloading, or an upload would discard it —
        // the lesson from the Stage 5 report upload.
        await using var db = await DbFactory.CreateDbContextAsync();
        await PersistAsync(db);

        switch (slot)
        {
            case MemoSlot:
                (await CurrentDisbursementAsync(db)).MemoFilePath = relativePath;
                break;
            case InsuranceSlot:
                (await CurrentDisbursementAsync(db)).InsuranceFilePath = relativePath;
                break;
            case GeneralDocSlot:
                (await CurrentDisbursementAsync(db)).GeneralDocFilePath = relativePath;
                break;
            case ReceiptSlot:
                var record = await db.DownPaymentRecords.FirstAsync(d => d.ApplicationId == ApplicationId);
                record.ReceiptFilePath = relativePath;
                break;
        }

        await db.SaveChangesAsync();
        await LoadAsync(db);

        await ShowToastAsync("File uploaded");
    }

    private Task<Disbursement> CurrentDisbursementAsync(LosDbContext db) =>
        db.Disbursements.FirstAsync(d => d.ApplicationId == ApplicationId);

