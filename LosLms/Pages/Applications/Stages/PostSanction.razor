    private string UrlFor(string relativePath) =>
        $"/files/{ApplicationId}/postsanction/{Path.GetFileName(relativePath)}";

    // ---------------------------------------------------------------------
    // Release funds
    // ---------------------------------------------------------------------

    private async Task ReleaseFundsAsync()
    {
        // Server-side gate. The sub-header already disables the button, but that is UX — a crafted
        // event or a stale circuit must not get past it. One shared check, never re-implemented.
        await using (var gateDb = await DbFactory.CreateDbContextAsync())
        {
            if (!(await GateCheckService.CanAdvanceAsync(gateDb, ApplicationId)).CanAdvance)
            {
                return;
            }
        }
        // The button carries a real disabled attribute; this repeats the check so a crafted request
        // cannot release funds against an unfinished checklist.
        if (ReleaseBlocked || _application is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        await PersistAsync(db);

        var application = await db.Applications.FirstAsync(a => a.Id == ApplicationId);
        application.Disbursed = true;

        // CurrentStage deliberately stays at 8 — this is the final stage, there is no Stage 9.

        await db.SaveChangesAsync();

        _disbursed = true;
        await ShowToastAsync("Funds released");
    }

    // ---------------------------------------------------------------------
    // Persistence
    // ---------------------------------------------------------------------

    private async Task PersistAsync(LosDbContext db)
    {
        if (_application is null)
        {
            return;
        }

        var disbursement = await db.Disbursements.FirstOrDefaultAsync(d => d.ApplicationId == ApplicationId);
        if (disbursement is null)
        {
            disbursement = new Disbursement { ApplicationId = ApplicationId };
            db.Disbursements.Add(disbursement);
        }

        disbursement.Type = _disbursement.Type;
        disbursement.BeneficiaryName = _disbursement.BeneficiaryName;
        disbursement.BeneficiaryAccount = _disbursement.BeneficiaryAccount;
        disbursement.PaymentMode = _disbursement.PaymentMode;
        disbursement.ValueDate = _disbursement.ValueDate;
        disbursement.Utr = _disbursement.Utr;
        disbursement.FirstEmiDate = _disbursement.FirstEmiDate;
        disbursement.EmiDayOfMonth = _disbursement.EmiDayOfMonth;
        disbursement.DisburseFromAccount = _disbursement.DisburseFromAccount;
        disbursement.TradeAdvance = _disbursement.TradeAdvance;
        disbursement.FirstEmiOverride = _disbursement.FirstEmiOverride;
        disbursement.EmiRoundedTo = _disbursement.EmiRoundedTo;
        disbursement.WelcomeLetterFilePath = _disbursement.WelcomeLetterFilePath;
        disbursement.WelcomeSmsStatus = _disbursement.WelcomeSmsStatus;
        disbursement.WelcomeSmsSentAt = _disbursement.WelcomeSmsSentAt;
        disbursement.AgreementFilePath = _disbursement.AgreementFilePath;
        // AgreementEsignStatus is deliberately NOT copied: the Digio webhook sets it server-side, and this
        // (auto)save from a stale page would otherwise overwrite 'Signed'. SendForEsignAsync writes it.

        var enach = await db.EnachMandates.FirstOrDefaultAsync(m => m.ApplicationId == ApplicationId);
        if (enach is null)
        {
            enach = new EnachMandate { ApplicationId = ApplicationId };
            db.EnachMandates.Add(enach);
        }

        enach.Umrn = _enach.Umrn;
        enach.Status = _enach.Status;
        enach.DebitDate = _enach.DebitDate;
        enach.LinkedAccount = _enach.LinkedAccount;
        CopyMandateFlow(_enach, enach);

        var snach = await db.SecurityNachMandates.FirstOrDefaultAsync(m => m.ApplicationId == ApplicationId);
        if (snach is null)
        {
            snach = new SecurityNachMandate { ApplicationId = ApplicationId };
            db.SecurityNachMandates.Add(snach);
        }

        snach.Umrn = _snach.Umrn;
        snach.Status = _snach.Status;
        snach.MandateHolder = _snach.MandateHolder;
        CopyMandateFlow(_snach, snach);

        var downPayment = await db.DownPaymentRecords.FirstOrDefaultAsync(d => d.ApplicationId == ApplicationId);
        if (downPayment is null)
        {
            downPayment = new DownPaymentRecord { ApplicationId = ApplicationId };
            db.DownPaymentRecords.Add(downPayment);
        }

        downPayment.AmountReceived = _downPayment.AmountReceived;
        downPayment.ReceiptNo = _downPayment.ReceiptNo;
        downPayment.ReceivedDate = _downPayment.ReceivedDate;

        // Checklist and PDD rows are seeded, never added or removed by the officer, so these are
        // straight field updates rather than the insert/update/delete diff the earlier stages need.
        var storedChecklist = await db.PostSanctionChecklists
            .Where(c => c.ApplicationId == ApplicationId).ToListAsync();

        foreach (var row in _checklist)
        {
            var target = storedChecklist.FirstOrDefault(c => c.Id == row.Id);
            if (target is null)
            {
                continue;
            }

            target.Flag = row.Flag;
            target.ClearedOn = row.ClearedOn;
            target.Remarks = row.Remarks;
        }

        var storedPdds = await db.Pdds.Where(p => p.ApplicationId == ApplicationId).ToListAsync();

        foreach (var row in _pdds)
        {
            var target = storedPdds.FirstOrDefault(p => p.Id == row.Id);
            if (target is null)
            {
                continue;
            }

            target.Status = row.Status;
            target.WaivedByOfficerId = row.WaivedByOfficerId;
        }
    }

    // ---------------------------------------------------------------------
    // Presentation helpers
    // ---------------------------------------------------------------------

    private static string BandFor(string status) => status switch
    {
        "Registered" => "healthy",
        "Rejected" => "risk",
        _ => "caution",
    };

    private string? PartyNameFor(string partyType) => _partyNames.GetValueOrDefault(partyType);

    /// <summary>Copies the shared registration-flow fields onto the tracked entity.</summary>
    private static void CopyMandateFlow(INachMandate from, INachMandate to)
    {
        to.AccountNumber = from.AccountNumber;
        to.Ifsc = from.Ifsc;
        to.BankName = from.BankName;
        to.BankBranch = from.BankBranch;
        to.NameMatchStatus = from.NameMatchStatus;
        to.NameMatchCheckedAt = from.NameMatchCheckedAt;
        to.ConfirmationAccepted = from.ConfirmationAccepted;
        to.MandateType = from.MandateType;
        to.DigitalMode = from.DigitalMode;
    }

    /// <summary>
    /// Commits the mandate tabs. Post Sanction has no Save draft button — its secondary action is
    /// "Disbursement memo" — so before this the only things that ever committed these rows were a
    /// file upload and Release funds. A mandate the officer just registered has to persist on its own.
    /// </summary>
    private async Task SaveMandatesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await PersistAsync(db);
        await db.SaveChangesAsync();
        await ShowToastAsync("Mandate saved");
    }

    private static string PddBandFor(string status) => status switch
    {
        "Received" => "healthy",
        "Waived" => "caution",
        _ => "risk",
    };

    private static string FormatInr(decimal amount) =>
        "₹" + Math.Round(amount, MidpointRounding.AwayFromZero).ToString("N0", IndianCulture);

    private async Task ShowToastAsync(string message)
    {
        _toast = message;

        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        // Explicit render — see the note in CustomerDetails.razor; without it the toast is set and
        // cleared between the only two renders an async handler triggers.
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer toast.
        }
    }

    public void Dispose()
    {
        _autoSave.Dispose();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
