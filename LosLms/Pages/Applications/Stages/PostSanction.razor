        yield return NewChecklistItem("Rate & PF approval", "Business head");
        yield return NewChecklistItem("Agreement executed", "Branch ops");
        yield return NewChecklistItem("RC / hypothecation endorsement", "Branch ops");
        yield return NewChecklistItem("Insurance assignment", "Branch ops");
        yield return NewChecklistItem("E-Nach registration", "Branch ops");
