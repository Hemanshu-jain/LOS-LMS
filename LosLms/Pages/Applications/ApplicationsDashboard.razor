@page "/applications"
@using System.Globalization
@using System.Text
@using LosLms.Components.Shared
@using LosLms.Data
@using LosLms.Models
@using LosLms.Services
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<LosDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TenantContext Tenant
@inject AdminRequestNotifier Notifier

<PageTitle>Applications · LOS/LMS</PageTitle>

@{
    // Computed once per render rather than through repeated property access, so filtering and
    // sorting run a single time no matter how many places below need the result.
    var filtered = FilteredRows;
    var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)_pageSize));
    var currentPage = Math.Clamp(_page, 1, totalPages);
    var paged = filtered.Skip((currentPage - 1) * _pageSize).Take(_pageSize).ToList();
    var firstShown = filtered.Count == 0 ? 0 : (currentPage - 1) * _pageSize + 1;
    var lastShown = Math.Min(currentPage * _pageSize, filtered.Count);
}

<div class="dashboard">
    <div class="dashboard-card">

        @* ---------- Top bar ---------- *@
        @* The signed-in user and the sign-out action moved to the global app bar in MainLayout,
           where every screen can reach them. What is left here is the card's own section label. *@
        <div class="top-bar">
            <span class="system-label">LOS/LMS · Applications</span>
        </div>

        @* ---------- Toolbar ---------- *@
        <div class="toolbar">
            <div class="toolbar-left">
                <div class="search-wrap">
                    <span class="search-icon"><Icon Name="search" /></span>
                    <input id="app-search" type="text" class="search-input"
                           placeholder="Application number, PAN or customer name (press / to focus)"
                           aria-label="Search applications"
                           @bind="_searchInput" @bind:event="oninput" @bind:after="DebounceSearchAsync" />
                </div>

                <button type="button" class="ghost-button" aria-expanded="@_showFilterPanel"
                        @onclick="() => _showFilterPanel = !_showFilterPanel">
                    Filters
                    <Icon Name="@(_showFilterPanel ? "chevron-up" : "chevron-down")" Size="13" />
                </button>

                <button type="button" class="ghost-button" aria-expanded="@_showColumnPanel"
                        @onclick="() => _showColumnPanel = !_showColumnPanel">
                    <Icon Name="columns" Size="14" /> Columns
                </button>

                <div class="density-toggle" role="group" aria-label="Row density">
                    <button type="button" class="@(_density == "compact" ? "is-active" : null)"
                            aria-pressed="@(_density == "compact")"
                            @onclick='() => _density = "compact"'>Compact</button>
                    <button type="button" class="@(_density == "comfortable" ? "is-active" : null)"
                            aria-pressed="@(_density == "comfortable")"
                            @onclick='() => _density = "comfortable"'>Comfortable</button>
                </div>

                <button type="button" class="ghost-button" @onclick="() => ExportCsvAsync(filtered)">
                    <Icon Name="download" Size="14" /> Export
                </button>
            </div>

            <button type="button" class="primary-button" @onclick="CreateApplicationAsync">
                <Icon Name="plus" Size="14" /> New application
            </button>
        </div>

        @* ---------- Column visibility panel ---------- *@
        @if (_showColumnPanel)
        {
            <div class="panel column-panel">
                @foreach (var column in ColumnDefs)
                {
                    <label class="checkbox-label">
                        <input type="checkbox"
                               checked="@_visibleColumns.Contains(column.Key)"
                               @onchange="() => ToggleColumn(column.Key)" />
                        @column.Label
                    </label>
                }
            </div>
        }

        @* ---------- Filter panel ---------- *@
        @if (_showFilterPanel)
        {
            <div class="panel filter-panel">
                <div class="filter-grid">
                    <FilterField Label="Product" Options="ProductOptions"
                                 Value="@_draft.Product"
                                 ValueChanged="@(v => _draft = _draft with { Product = v })" />

                    <FilterField Label="Branch" Options="_branchOptions"
                                 Value="@_draft.Branch"
                                 ValueChanged="@(v => _draft = _draft with { Branch = v })" />

                    <FilterField Label="Stage / status" Options="StageOptions"
                                 Value="@_draft.Stage"
                                 ValueChanged="@(v => _draft = _draft with { Stage = v })" />

                    <div class="date-range-field">
                        <span class="field-label">Queued between</span>
                        <div class="date-range-inputs">
                            <input type="date" class="date-input" aria-label="Queued from"
                                   value="@_draft.From"
                                   @onchange="e => _draft = _draft with { From = e.Value?.ToString() ?? string.Empty }" />
                            <span class="date-range-dash">–</span>
                            <input type="date" class="date-input" aria-label="Queued to"
                                   value="@_draft.To"
                                   @onchange="e => _draft = _draft with { To = e.Value?.ToString() ?? string.Empty }" />
                        </div>
                    </div>

                    <FilterField Label="Sourcing channel" Options="ChannelOptions"
                                 Value="@_draft.Channel"
                                 ValueChanged="@(v => _draft = _draft with { Channel = v })" />

                    <FilterField Label="Assigned officer" Options="_officerOptions"
                                 Value="@_draft.Officer"
                                 ValueChanged="@(v => _draft = _draft with { Officer = v })" />
                </div>

                <div class="filter-actions">
                    <button type="button" class="link-button" @onclick="ClearFilters">Clear all</button>
                    <button type="button" class="apply-button" @onclick="ApplyFilters">Apply filters</button>
                </div>
            </div>
        }

        @* ---------- Saved views ---------- *@
        <div class="chip-row">
            <span class="chip-row-label">Saved views:</span>
            @foreach (var view in SavedViews)
            {
                <button type="button" class="chip-button" @onclick="() => ApplySavedView(view)">@view</button>
            }
        </div>

        @* ---------- Recently viewed ---------- *@
        @if (_recentIds.Count > 0)
        {
            <div class="chip-row">
                <Icon Name="history" Size="13" />
                <span class="chip-row-label">Recently viewed:</span>
                @foreach (var id in _recentIds)
                {
                    <button type="button" class="chip-button" @onclick="() => OpenDrawer(id)">@id</button>
                }
            </div>
        }

        @* ---------- Triage strip ---------- *@
        <div class="triage-strip">
            @foreach (var status in StatusOrder)
            {
                var colors = StatusColors[status];
                var isActive = _statusFilter == status;
                var cardStyle = isActive ? "background:" + colors.Bg + ";" : null;
                var countStyle = "color:" + colors.Text + ";";

                <button type="button"
                        class="triage-card @(isActive ? "is-active" : null)"
                        aria-pressed="@isActive"
                        style="@cardStyle"
                        @onclick="() => ToggleStatusFilter(status)">
                    <span class="triage-count" style="@countStyle">@_statusCounts[status]</span>
                    <span class="triage-label">@status</span>
                </button>
            }
            @if (_statusFilter is not null)
            {
                <button type="button" class="link-button triage-clear" @onclick="() => ToggleStatusFilter(_statusFilter)">
                    Clear filter
                </button>
            }
        </div>

        @* ---------- Tabs ---------- *@
        <div class="tabs" role="tablist">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab"
                        class="tab @(_activeTab == tab ? "is-active" : null)"
                        aria-selected="@(_activeTab == tab)"
                        @onclick="() => SelectTab(tab)">@tab</button>
            }
        </div>

        @if (!IsDataTab)
        {
            <div class="tab-placeholder">
                <p class="tab-placeholder-title">“@_activeTab” is not yet wired up.</p>
                <p class="tab-placeholder-body">
                    This tab needs its own server-side query against the applications table.
                    Only “Assigned to me” has data in this build.
                </p>
            </div>
        }
        else
        {
            @* ---------- Bulk action bar ---------- *@
            @if (_selected.Count > 0)
            {
                <div class="bulk-bar">
                    <span class="bulk-count">@_selected.Count selected</span>
                    <div class="bulk-actions">
                        @* Reassign and Export are visual stubs for this pass. *@
                        <button type="button" class="chip-button">Reassign</button>
                        <button type="button" class="chip-button">Export</button>
                        <button type="button" class="chip-button" @onclick="() => _selected.Clear()">Clear selection</button>
                    </div>
                </div>
            }

            @* ---------- Table ---------- *@
            <div class="table-scroll">
                <table class="applications-table @(_density == "comfortable" ? "density-comfortable" : "density-compact")">
                    <thead>
                        <tr>
                            <th class="checkbox-header" scope="col">
                                <input type="checkbox" aria-label="Select all rows on this page"
                                       checked="@AllPagedSelected(paged)"
                                       @onchange="() => ToggleAllOnPage(paged)" />
                            </th>
                            <SortableHeader Label="App ID" SortKeyName="id"
                                            CurrentKey="@_sortKey" SortDir="@_sortDir" OnSort="HandleSort" />
                            @foreach (var column in ColumnDefs.Where(c => _visibleColumns.Contains(c.Key)))
                            {
                                <SortableHeader Label="@column.Label" SortKeyName="@column.Key"
                                                Align="@(column.Key == "amount" ? "right" : "left")"
                                                CurrentKey="@_sortKey" SortDir="@_sortDir" OnSort="HandleSort" />
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in paged)
                        {
                            var statusColors = StatusColors[row.Status];
                            var age = DaysQueued(QueueDateOf(row));
                            var overdue = age > _policy.SlaOverdueDays;
                            var badgeStyle = "background:" + statusColors.Bg + ";color:" + statusColors.Text + ";";
                            var selectLabel = "Select application " + row.Id;
                            var overdueTitle = age + " days since queued — past " + _policy.SlaOverdueDays + "-day SLA";

                            <tr @key="row.Id" class="data-row" @onclick="() => OpenDrawer(row.Id)">
                                <td class="checkbox-cell" @onclick:stopPropagation="true">
                                    <input type="checkbox" aria-label="@selectLabel"
                                           checked="@_selected.Contains(row.Id)"
                                           @onchange="() => ToggleRow(row.Id)" />
                                </td>
                                <td class="cell-id">@row.Id</td>

                                @if (_visibleColumns.Contains("product"))
                                {
                                    <td class="cell-truncate" title="@row.LoanProduct">@row.LoanProduct</td>
                                }
                                @if (_visibleColumns.Contains("branch"))
                                {
                                    <td class="cell-truncate" title="@row.Branch">@row.Branch</td>
                                }
                                @if (_visibleColumns.Contains("customer"))
                                {
                                    <td class="cell-truncate" title="@row.CustomerName">@row.CustomerName</td>
                                }
                                @if (_visibleColumns.Contains("amount"))
                                {
                                    <td class="cell-amount">@FormatInr(row.LoanAmount)</td>
                                }
                                @if (_visibleColumns.Contains("status"))
                                {
                                    <td>
                                        <span class="status-badge" style="@badgeStyle">@row.Status</span>
                                        <div class="cell-stage">@StageLabel(row.CurrentStage)</div>
                                    </td>
                                }
                                @if (_visibleColumns.Contains("queueDate"))
                                {
                                    <td class="cell-queue-date">
                                        <div class="queue-date-inner">
                                            @QueueDateOf(row).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                            @if (overdue)
                                            {
                                                <span class="sla-warning" title="@overdueTitle">
                                                    <Icon Name="alert" Size="12" />
                                                </span>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (paged.Count == 0)
                        {
                            <tr>
                                <td class="empty-row" colspan="@(2 + _visibleColumns.Count)">
                                    No applications match the current filters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---------- Footer ---------- *@
            <div class="table-footer">
                <div class="footer-left">
                    <span class="footer-count">
                        Showing @firstShown–@lastShown of @filtered.Count applications
                    </span>
                    <label class="rows-per-page">
                        Rows per page
                        <select value="@_pageSize" @onchange="HandlePageSizeChanged">
                            @foreach (var size in PageSizes)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="pagination">
                    <button type="button" class="page-btn" aria-label="Previous page"
                            disabled="@(currentPage == 1)"
                            @onclick="() => _page = Math.Max(1, currentPage - 1)">
                        <Icon Name="chevron-left" Size="13" />
                    </button>

                    @{
                        var pageNumbers = GetPageNumbers(currentPage, totalPages);
                        var previous = 0;
                    }
                    @foreach (var number in pageNumbers)
                    {
                        if (previous > 0 && number - previous > 1)
                        {
                            <span class="page-gap">…</span>
                        }
                        var target = number;
                        <button type="button"
                                class="page-btn @(target == currentPage ? "is-active" : null)"
                                aria-current="@(target == currentPage ? "page" : null)"
                                @onclick="() => _page = target">@target</button>
                        previous = number;
                    }

                    <button type="button" class="page-btn" aria-label="Next page"
                            disabled="@(currentPage == totalPages)"
                            @onclick="() => _page = Math.Min(totalPages, currentPage + 1)">
                        <Icon Name="chevron-right" Size="13" />
                    </button>
                </div>
            </div>
        }

        @* ---------- Quick-view drawer ---------- *@
        @if (DrawerApp is { } drawerApp)
        {
            var drawerColors = StatusColors[drawerApp.Status];
            var drawerBadgeStyle = "background:" + drawerColors.Bg + ";color:" + drawerColors.Text + ";";

            <div class="drawer-backdrop" @onclick="CloseDrawer">
                @* Escape is handled here rather than through a global JS listener — the drawer is
                   focused when it opens, so a locally scoped keydown is all it needs. *@
                <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Application quick view"
                     tabindex="-1" @ref="_drawerPanel"
                     @onclick:stopPropagation="true"
                     @onkeydown="HandleDrawerKeyDown">

                    <div class="drawer-header">
                        <div>
                            <div class="drawer-id">@drawerApp.Id</div>
                            <span class="status-badge drawer-status" style="@drawerBadgeStyle">@drawerApp.Status</span>
                        </div>
                        <button type="button" class="drawer-close" aria-label="Close" @onclick="CloseDrawer">
                            <Icon Name="x" Size="16" />
                        </button>
                    </div>

                    <div class="drawer-stage">@StageLabel(drawerApp.CurrentStage)</div>

                    @if (drawerApp.Status == "Rejected")
                    {
                        var rejection = _latestRejections.TryGetValue(drawerApp.Id, out var info) ? info : default;
                        <div class="drawer-rejected-banner" role="alert">
                            ⛔ This application was rejected@(rejection.At == default ? null : " on " + DateOnly.FromDateTime(rejection.At).ToString("dd MMM yyyy", CultureInfo.InvariantCulture))@(string.IsNullOrWhiteSpace(rejection.Reason) ? null : " — " + rejection.Reason).
                        </div>
                    }

                    <DrawerRow Label="Product" Value="@(drawerApp.LoanProduct ?? "—")" />
                    <DrawerRow Label="Branch" Value="@(drawerApp.Branch ?? "—")" />
                    <DrawerRow Label="Customer" Value="@(drawerApp.CustomerName ?? "—")" />
                    <DrawerRow Label="Loan amount" Value="@FormatInr(drawerApp.LoanAmount)" />
                    <DrawerRow Label="Queue date" Value="@QueueDateOf(drawerApp).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />

                    @* The one editable drawer field — saves on change, no separate save button. *@
                    <div class="drawer-assign">
                        <span class="drawer-assign-label">Assigned officer</span>
                        <div class="drawer-assign-control">
                            <select class="drawer-assign-select" aria-label="Assigned officer"
                                    value="@(drawerApp.AssignedOfficerId ?? string.Empty)"
                                    @onchange="AssignOfficerAsync">
                                <option value="">— Unassigned —</option>
                                @foreach (var officer in _officers)
                                {
                                    <option value="@officer.Id">@officer.DisplayName</option>
                                }
                            </select>
                            @if (_officerSavedMessage is not null)
                            {
                                <span class="drawer-saved" role="status">@_officerSavedMessage</span>
                            }
                        </div>
                    </div>

                    <button type="button" class="drawer-open-button"
                            @onclick="() => OpenFullApplication(drawerApp.Id)">
                        Open full application →
                    </button>

                    @* Rejecting is out of scope once Sanctioned, and pointless once Rejected. *@
                    @if (drawerApp.Status is not "Sanctioned" and not "Rejected")
                    {
                        <button type="button" class="drawer-reject-button"
                                @onclick="() => _showDrawerReject = true">
                            Reject application
                        </button>
                    }

                    @* Inside the drawer body, directly under the button it answers — outside it, the
                       panel's own overflow hides it and the officer sees nothing happen. *@
                    @if (_drawerRejectRequested)
                    {
                        <div class="drawer-request-note" role="status">
                            Rejection requested — an Admin will review it. This application is
                            unchanged until then.
                        </div>
                    }
                </div>
            </div>

            @if (_showDrawerReject)
            {
                <RejectDialog OnConfirm="ConfirmDrawerRejectAsync"
                              OnCancel="() => _showDrawerReject = false" />
            }
        }
    </div>
</div>

@code {
    // ---------------------------------------------------------------------
    // Constants
    // ---------------------------------------------------------------------

    /// <summary>
    /// This company's policy, loaded per page load. Was a hardcoded five-day SLA window; it is now
    /// editable in Company Setup. Falls back to the old defaults until the first load completes.
    /// </summary>
    private CompanyPolicy _policy = CompanyPolicy.Fallback;

    /// <summary>Blazor Server round-trips every keystroke over SignalR, so the search waits.</summary>
    private const int SearchDebounceMs = 300;

    private const int MaxRecentlyViewed = 5;

    private const string AllProductsOption = "All products";
    private const string AllBranchesOption = "All branches";
    private const string AllStagesOption = "All stages";
    private const string AllChannelsOption = "All channels";
    private const string AllOfficersOption = "All officers";

    private const string AssignedToMeTab = "Assigned to me";

    private static readonly string[] Tabs = { AssignedToMeTab, "All applications", "Migrated data" };
    private static readonly string[] StatusOrder = { "New", "In progress", "Sanctioned", "Rejected" };
    private static readonly string[] SavedViews = { "My open cases", "Rejected only" };
    private static readonly int[] PageSizes = { 25, 50, 100 };

    private static readonly string[] ProductOptions =
        { AllProductsOption, "Commercial vehicle", "Loan against property" };

    // Loaded from the Branches table, scoped to the signed-in user's company by the global query
    // filter. The sentinel is prepended in LoadAsync so it always heads the list.
    private string[] _branchOptions = { AllBranchesOption };

    private static readonly string[] StageOptions =
        { AllStagesOption, "New", "In progress", "Sanctioned", "Rejected" };

    // Widened when Stage 2 introduced named sourcing partners; seeded "DSA" rows were migrated to
    // "DSA — Patil Motors" so this filter and the stored values share one vocabulary.
    private static readonly string[] ChannelOptions =
        { AllChannelsOption, "DSA — Patil Motors", "DSA — Shree Associates", "Branch walk-in", "Digital" };

    private static readonly (string Key, string Label)[] ColumnDefs =
    {
        ("product", "Product"),
        ("branch", "Branch"),
        ("customer", "Customer name"),
        ("amount", "Loan amount"),
        ("status", "Status · stage"),
        ("queueDate", "Queue date"),
    };

    /// <summary>
    /// Stage text for the dashboard's "Status · stage" column, indexed by CurrentStage.
    /// </summary>
    /// <remarks>
    /// Kept in the dashboard's own wording rather than the stepper's, so the column renders exactly
    /// as it did before the schema landed and the stage number became the stored value.
    /// </remarks>
    private static readonly string[] StageLabels =
    {
        "Stage 1 · Customer details",
        "Stage 2 · Loan & security",
        "Stage 3 · Bank & financial",
        "Stage 4 · Documents",
        "Stage 5 · Reports (RCU)",
        "Stage 6 · Eligibility",
        "Stage 7 · Approvals",
        "Stage 8 · Post sanction",
    };

    private static readonly Dictionary<string, (string Bg, string Text)> StatusColors = new()
    {
        ["New"] = ("#e8e9ec", "#3b4453"),
        ["In progress"] = ("#fbe8c9", "#7a4b06"),
        ["Sanctioned"] = ("#d9ecd7", "#1f5c2a"),
        ["Rejected"] = ("#f8d7d7", "#8a1f1f"),
    };

    private static readonly Dictionary<string, int> StatusPriority = new()
    {
        ["New"] = 0,
        ["In progress"] = 1,
        ["Sanctioned"] = 2,
        ["Rejected"] = 3,
    };

    private static readonly CultureInfo IndianCulture = CultureInfo.GetCultureInfo("en-IN");

    // ---------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------

    private sealed record FilterSet(
        string Product,
        string Branch,
        string Stage,
        string Channel,
        string Officer,
        string From,
        string To)
    {
        public static readonly FilterSet Empty = new(
            AllProductsOption, AllBranchesOption, AllStagesOption,
            AllChannelsOption, AllOfficersOption, string.Empty, string.Empty);
    }

    private FilterSet _draft = FilterSet.Empty;    // what the panel shows
    private FilterSet _applied = FilterSet.Empty;  // what the table obeys

    private bool _showFilterPanel;
    private bool _showColumnPanel;
    private string _activeTab = AssignedToMeTab;
    private string? _statusFilter;
    private string _sortKey = "queueDate";
    private string _sortDir = "desc";
    private string _density = "compact";
    private int _page = 1;
    private int _pageSize = 25;
    private string? _drawerId;

    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _visibleColumns =
        new(ColumnDefs.Select(c => c.Key), StringComparer.Ordinal);
    private readonly List<string> _recentIds = new();

    private string _searchInput = string.Empty;
    private string _searchApplied = string.Empty;
    private CancellationTokenSource? _searchDebounce;

    // Seeded with zeros rather than left empty. OnInitializedAsync returns an incomplete task, so
    // Blazor renders the component once before the counts have loaded; without every key present
    // that first pass throws KeyNotFoundException on the triage strip.
    private Dictionary<string, int> _statusCounts =
        StatusOrder.ToDictionary(status => status, _ => 0, StringComparer.Ordinal);

    private List<Application> _allRows = new();
    private Dictionary<string, List<string>> _pansByApplication = new(StringComparer.Ordinal);

    private List<ApplicationUser> _officers = new();
    private IReadOnlyList<string> _officerOptions = new[] { AllOfficersOption };

    // Latest rejection reason + date per application, for the drawer banner. Few rows, loaded whole.
    private Dictionary<string, (string Reason, DateTime At)> _latestRejections =
        new(StringComparer.Ordinal);

    private bool _showDrawerReject;

    /// <summary>Staff asked for a rejection; the file is unchanged until an Admin decides.</summary>
    private bool _drawerRejectRequested;
    private string? _officerSavedMessage;

    private ElementReference _drawerPanel;
    private bool _shouldFocusDrawer;

    // ---------------------------------------------------------------------
    // Lifecycle
    // ---------------------------------------------------------------------

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// Reads the whole applications table once per page load and filters in memory afterwards.
    /// </summary>
    /// <remarks>
    /// ponytail: a few hundred rows is nothing, and keeping the filter/sort pipeline in C# means
    /// the behaviour verified against the mock data is unchanged. Push filtering and paging into
    /// SQL when this table is large enough to actually hurt, not before.
    /// </remarks>
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _allRows = await db.Applications.AsNoTracking().ToListAsync();

        _officers = await db.Users.AsNoTracking()
            .Where(u => u.IsActive)
            .OrderBy(u => u.DisplayName)
            .ToListAsync();
        _officerOptions = new[] { AllOfficersOption }
            .Concat(_officers.Select(o => o.DisplayName))
            .ToList();

        _policy = await CompanyPolicyReader.ForCurrentCompanyAsync(db, Tenant);

        _branchOptions = new[] { AllBranchesOption }
            // Active only. A deactivated branch stops being offered on new work but still renders on
            // the applications that already sourced through it, because those store the name.
            .Concat(await db.Branches.AsNoTracking()
                .Where(b => b.IsActive)
                .OrderBy(b => b.Name)
                .Select(b => b.Name)
                .ToListAsync())
            .ToArray();

        _latestRejections = (await db.RejectionLogs.AsNoTracking().ToListAsync())
            .GroupBy(r => r.ApplicationId, StringComparer.Ordinal)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    var latest = g.OrderByDescending(r => r.Id).First();
                    return (latest.Reason, latest.RejectedAt);
                },
                StringComparer.Ordinal);

        // PAN moved to the Parties table with the schema, but the dashboard still searches on it,
        // so the identifiers are pulled once and matched in memory alongside id and customer name.
        var pans = await db.Parties.AsNoTracking()
            .Where(p => p.Pan != null && p.Pan != "")
            .Select(p => new { p.ApplicationId, p.Pan })
            .ToListAsync();

        _pansByApplication = pans
            .GroupBy(x => x.ApplicationId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Pan!).ToList(), StringComparer.Ordinal);

        // Triage counts come from the whole dataset, unfiltered, matching the reference spec.
        // In production this belongs in a server-side aggregate query, not a client-side scan.
        _statusCounts = StatusOrder.ToDictionary(
            status => status,
            status => _allRows.Count(row => row.Status == status));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusDrawer && _drawerId is not null)
        {
            _shouldFocusDrawer = false;
            await _drawerPanel.FocusAsync();
        }
    }

    public void Dispose()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }

