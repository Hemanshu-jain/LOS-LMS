    private async Task DebounceSearchAsync()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;

        try
        {
            await Task.Delay(SearchDebounceMs, token);
            _searchApplied = _searchInput;
            _page = 1;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke superseded this one before the window elapsed.
        }
    }

    private void HandleSort(string key)
    {
        if (_sortKey == key)
        {
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            _sortKey = key;
            _sortDir = "asc";
        }

        _page = 1;
    }

    private void ToggleColumn(string key)
    {
        if (!_visibleColumns.Remove(key))
        {
            _visibleColumns.Add(key);
        }
    }

    private void ToggleRow(string id)
    {
        if (!_selected.Remove(id))
        {
            _selected.Add(id);
        }
    }

    private void ToggleAllOnPage(IReadOnlyList<Application> paged)
    {
        if (AllPagedSelected(paged))
        {
            foreach (var row in paged)
            {
                _selected.Remove(row.Id);
            }

            return;
        }

        foreach (var row in paged)
        {
            _selected.Add(row.Id);
        }
    }

    private void ToggleStatusFilter(string? status)
    {
        _statusFilter = _statusFilter == status ? null : status;
        _page = 1;
    }

    private void ApplyFilters()
    {
        _applied = _draft;
        _page = 1;
    }

    private void ClearFilters()
    {
        _draft = FilterSet.Empty;
        _applied = FilterSet.Empty;
        _statusFilter = null;
        _page = 1;
    }

    private void ApplySavedView(string view)
    {
        switch (view)
        {
            case "My open cases":
                _statusFilter = null;
                _activeTab = AssignedToMeTab;
                break;

            case "Rejected only":
                _statusFilter = "Rejected";
                _activeTab = AssignedToMeTab;
                break;
        }

        _page = 1;
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        _selected.Clear();
        _page = 1;
    }

    private void HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var size))
        {
            _pageSize = size;
            _page = 1;
        }
    }

    private void OpenDrawer(string id)
    {
        _drawerId = id;
        _showDrawerReject = false;
        _officerSavedMessage = null;

        _recentIds.Remove(id);
        _recentIds.Insert(0, id);
        if (_recentIds.Count > MaxRecentlyViewed)
        {
            _recentIds.RemoveRange(MaxRecentlyViewed, _recentIds.Count - MaxRecentlyViewed);
        }

        _shouldFocusDrawer = true;
    }

    private void CloseDrawer()
    {
        _drawerId = null;
        _showDrawerReject = false;
        _drawerRejectRequested = false;
        _officerSavedMessage = null;
    }

    /// <summary>
    /// The only drawer field that writes. Saves the officer FK immediately — the drawer has no save
    /// button — and keeps the legacy name string in sync so the two never disagree.
    /// </summary>
    private async Task AssignOfficerAsync(ChangeEventArgs e)
    {
        if (DrawerApp is not { } app)
        {
            return;
        }

        var selected = e.Value?.ToString();
        var officerId = string.IsNullOrWhiteSpace(selected) ? null : selected;

        await using var db = await DbFactory.CreateDbContextAsync();
        var application = await db.Applications.FirstAsync(a => a.Id == app.Id);
        application.AssignedOfficerId = officerId;
        application.AssignedOfficer = officerId is { } oid
            ? _officers.FirstOrDefault(o => o.Id == oid)?.DisplayName
            : null;
        await db.SaveChangesAsync();

        await LoadAsync();

        _officerSavedMessage = "Saved ✓";
        StateHasChanged();

        await Task.Delay(2500);
        if (_officerSavedMessage == "Saved ✓")
        {
            _officerSavedMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmDrawerRejectAsync(string reason)
    {
        _showDrawerReject = false;

        if (DrawerApp is not { } app)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // A request, not a rejection. The status does not move until an Admin approves it, so the
        // table badge and triage counts deliberately stay exactly as they were.
        await RejectionService.RequestAsync(db, Notifier, app.Id, Tenant.UserId, reason);

        _drawerRejectRequested = true;
        await LoadAsync();
    }

    private void HandleDrawerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDrawer();
        }
    }

    private async Task ExportCsvAsync(IReadOnlyList<Application> rows)
    {
        var csv = new StringBuilder();
        csv.Append("App ID,Product,Branch,Customer name,Loan amount,Status,Stage,Queue date\n");

        foreach (var row in rows)
        {
            var fields = new[]
            {
                row.Id,
                row.LoanProduct ?? string.Empty,
                row.Branch ?? string.Empty,
                row.CustomerName ?? string.Empty,
                row.LoanAmount.ToString("0", CultureInfo.InvariantCulture),
                row.Status,
                StageLabel(row.CurrentStage),
                QueueDateOf(row).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            };

            csv.Append(string.Join(',', fields.Select(CsvQuote))).Append('\n');
        }

        await JS.InvokeVoidAsync("downloadFile", "applications.csv", csv.ToString());
    }

    private static string CsvQuote(string value) => '"' + value.Replace("\"", "\"\"") + '"';
}
