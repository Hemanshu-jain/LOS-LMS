    private bool IsDataTab => _activeTab == AssignedToMeTab;

    private Application? DrawerApp =>
        _drawerId is null ? null : _allRows.FirstOrDefault(row => row.Id == _drawerId);

    private List<Application> FilteredRows
    {
        get
        {
            IEnumerable<Application> rows = _allRows;

            if (_applied.Product != AllProductsOption)
            {
                rows = rows.Where(row => row.LoanProduct == _applied.Product);
            }

            if (_applied.Branch != AllBranchesOption)
            {
                rows = rows.Where(row => row.Branch == _applied.Branch);
            }

            if (_applied.Stage != AllStagesOption)
            {
                rows = rows.Where(row => row.Status == _applied.Stage);
            }

            if (_applied.Channel != AllChannelsOption)
            {
                rows = rows.Where(row => row.SourcingChannel == _applied.Channel);
            }

            if (_applied.Officer != AllOfficersOption)
            {
                // Filter on the real FK, resolving the chosen name to its officer id (names are
                // unique in the Officers table). This is the column the drawer now writes.
                var officerId = _officers.FirstOrDefault(o => o.DisplayName == _applied.Officer)?.Id;
                rows = rows.Where(row => row.AssignedOfficerId == officerId);
            }

            if (TryParseDate(_applied.From, out var from))
            {
                rows = rows.Where(row => QueueDateOf(row) >= from);
            }

            if (TryParseDate(_applied.To, out var to))
            {
                rows = rows.Where(row => QueueDateOf(row) <= to);
            }

            if (_statusFilter is not null)
            {
                rows = rows.Where(row => row.Status == _statusFilter);
            }

            if (!string.IsNullOrWhiteSpace(_searchApplied))
            {
                var term = _searchApplied.Trim();
                rows = rows.Where(row =>
                    row.Id.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (row.CustomerName ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    MatchesPan(row.Id, term));
            }

            var result = rows.ToList();

            // The reference spec negates its comparator, which makes "asc" sort descending and
            // leaves the arrow indicator contradicting the visible order. Corrected here.
            var sign = _sortDir == "asc" ? 1 : -1;
            result.Sort((a, b) => sign * CompareRows(a, b, _sortKey));
            return result;
        }
    }

    private static bool TryParseDate(string value, out DateOnly date) =>
        DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out date);

    private static int CompareRows(Application a, Application b, string key) => key switch
    {
        "amount" => a.LoanAmount.CompareTo(b.LoanAmount),
        "queueDate" => a.CreatedAt.CompareTo(b.CreatedAt),
        "status" => StatusPriority[a.Status].CompareTo(StatusPriority[b.Status]),
        "id" => string.Compare(a.Id, b.Id, StringComparison.OrdinalIgnoreCase),
        "product" => string.Compare(a.LoanProduct, b.LoanProduct, StringComparison.OrdinalIgnoreCase),
        "branch" => string.Compare(a.Branch, b.Branch, StringComparison.OrdinalIgnoreCase),
        "customer" => string.Compare(a.CustomerName, b.CustomerName, StringComparison.OrdinalIgnoreCase),
        _ => 0,
    };

    private static List<int> GetPageNumbers(int current, int total)
    {
        var pages = new SortedSet<int> { 1, total, current - 1, current, current + 1 };
        return pages.Where(page => page >= 1 && page <= total).ToList();
    }

    /// <summary>The application's queue date. CreatedAt doubles as it.</summary>
    private static DateOnly QueueDateOf(Application row) => DateOnly.FromDateTime(row.CreatedAt);

    /// <summary>Stage text for the dashboard, derived rather than stored.</summary>
    private static string StageLabel(int stage) =>
        stage >= 1 && stage <= StageLabels.Length ? StageLabels[stage - 1] : $"Stage {stage}";

    private bool MatchesPan(string applicationId, string term) =>
        _pansByApplication.TryGetValue(applicationId, out var pans)
        && pans.Any(pan => pan.Contains(term, StringComparison.OrdinalIgnoreCase));

    // Measured against the server date. This used to run off a fixed anchor baked into the old seed
    // data, which meant every queue age drifted by a day for every day that passed.
    private static int DaysQueued(DateOnly queueDate) =>
        DateOnly.FromDateTime(DateTime.Today).DayNumber - queueDate.DayNumber;

    private static string FormatInr(decimal amount) => "₹" + amount.ToString("N0", IndianCulture);

    private bool AllPagedSelected(IReadOnlyList<Application> paged) =>
        paged.Count > 0 && paged.All(row => _selected.Contains(row.Id));

    // ---------------------------------------------------------------------
    // Creating and opening applications
    // ---------------------------------------------------------------------

    private async Task CreateApplicationAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var id = await NextApplicationIdAsync(db);

        // Branch is left unset. It used to be stamped with a hardcoded "Nashik West", which was
        // wrong the moment a second company existed and had branches of its own. The officer picks
        // the real one from the company's branch list on Loan & Security, which is stage 2.
        //
        // CompanyId is not set here either — LosDbContext stamps it from the signed-in user's claims
        // on insert, so it can never be chosen by anything the browser sends.
        db.Applications.Add(new Application
        {
            Id = id,
            Status = "New",
            CurrentStage = 1,
        });

        await db.SaveChangesAsync();

        Navigation.NavigateTo($"/applications/{id}/customer-details");
    }

    private void OpenFullApplication(string applicationId) =>
        Navigation.NavigateTo($"/applications/{applicationId}/customer-details");

    /// <remarks>
    /// ponytail: highest-sequence-plus-one. Two officers creating an application in the same
    /// instant can collide; the fix is a database sequence or retry-on-duplicate-key, which is
    /// worth adding once this is genuinely multi-user rather than now.
    /// </remarks>
    private static async Task<string> NextApplicationIdAsync(LosDbContext db)
    {
        var prefix = $"LN-{DateTime.UtcNow.Year}-";

        var highest = await db.Applications
            .Where(a => a.Id.StartsWith(prefix))
            .OrderByDescending(a => a.Id)
            .Select(a => a.Id)
            .FirstOrDefaultAsync();

        var next = 1;
        if (highest is not null && int.TryParse(highest.AsSpan(prefix.Length), out var parsed))
        {
            next = parsed + 1;
        }

        return prefix + next.ToString("D6", CultureInfo.InvariantCulture);
    }

