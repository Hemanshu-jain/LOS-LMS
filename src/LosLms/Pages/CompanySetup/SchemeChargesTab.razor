@using LosLms.Components.Shared
@using LosLms.Data
@using LosLms.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LosDbContext> DbFactory

@* Default charge lines per scheme. When an application on the chosen scheme first reaches Approvals
   and has no charges yet, one Charge row is created from each line here — so the officer stops
   retyping the same processing / documentation / stamp / service charges on every file. *@

<Panel Title="Scheme charges">
    <ChildContent>
        <p class="setup-note">
            Set the charges that should appear automatically on every new file for a scheme. Pick a
            scheme, then add each charge head with either a flat rupee amount or a percentage of the
            loan. These are copied onto the file's Charges tab when it first opens — the officer can
            still edit or waive any of them, and editing a template here never changes files already
            created. Leave a scheme empty to keep the built-in starter charges.
        </p>

        <div class="setup-inline-add">
            <label class="setup-inline-label" for="sc-scheme">Scheme</label>
            <select id="sc-scheme" class="field-input" value="@_scheme" @onchange="OnSchemeChanged">
                <option value="">— Select a scheme —</option>
                @foreach (var s in _schemes) { <option value="@s">@s</option> }
            </select>
        </div>

        @if (_scheme.Length > 0)
        {
            <div class="table-scroll">
                <table class="row-table">
                    <thead>
                        <tr>
                            <th>Charge head</th>
                            <th>Basis</th>
                            <th>Value</th>
                            <th>GST</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            var r = row;
                            <tr>
                                <td><input class="cell-input" maxlength="80" @bind="r.Head" @bind:event="oninput" /></td>
                                <td>
                                    <select class="cell-input" @bind="r.IsPercent">
                                        <option value="false">Flat (₹)</option>
                                        <option value="true">% of loan</option>
                                    </select>
                                </td>
                                <td><input class="cell-input" type="number" step="0.01" min="0" @bind="r.Value" @bind:event="oninput" /></td>
                                <td>
                                    <input type="checkbox" @bind="r.GstApplicable" aria-label="@(r.Head + " GST applicable")" />
                                </td>
                                <td class="align-right">
                                    <button type="button" class="row-action" @onclick="() => RemoveRow(r)">Remove</button>
                                </td>
                            </tr>
                        }
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="5" class="empty-row">No charges yet — this scheme uses the built-in starter charges.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="setup-inline-add">
                <input class="field-input" placeholder="Charge head (e.g. Documentation)" maxlength="80"
                       @bind="_newHead" @bind:event="oninput" />
                <select class="field-input" @bind="_newIsPercent">
                    <option value="false">Flat (₹)</option>
                    <option value="true">% of loan</option>
                </select>
                <input class="field-input" type="number" step="0.01" min="0" placeholder="Value"
                       @bind="_newValue" @bind:event="oninput" />
                <label class="setup-inline-label"><input type="checkbox" @bind="_newGst" /> GST</label>
                <button type="button" class="setup-save" disabled="@string.IsNullOrWhiteSpace(_newHead)"
                        @onclick="AddRow">Add charge</button>
            </div>

            <div class="setup-actions">
                <button type="button" class="setup-save" @onclick="SaveAsync">Save changes</button>
            </div>
        }
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired] public int CompanyId { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private List<string> _schemes = new();
    private string _scheme = string.Empty;
    private List<SchemeChargeTemplate> _rows = new();

    private string? _newHead;
    private bool _newIsPercent;
    private decimal _newValue;
    private bool _newGst = true;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _schemes = await db.LookupValues.AsNoTracking()
            .Where(l => l.Kind == LookupKind.Scheme && l.IsActive)
            .OrderBy(l => l.Name).Select(l => l.Name).ToListAsync();
    }

    private async Task OnSchemeChanged(ChangeEventArgs e)
    {
        _scheme = e.Value?.ToString() ?? string.Empty;
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        if (_scheme.Length == 0) { _rows = new(); return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        _rows = await db.SchemeChargeTemplates
            .Where(t => t.Scheme == _scheme).OrderBy(t => t.Id).ToListAsync();
    }

    private void AddRow()
    {
        var head = _newHead?.Trim();
        if (string.IsNullOrWhiteSpace(head)) { return; }

        _rows.Add(new SchemeChargeTemplate
        {
            CompanyId = CompanyId, Scheme = _scheme, Head = head,
            IsPercent = _newIsPercent, Value = _newValue, GstApplicable = _newGst,
        });

        _newHead = null;
        _newIsPercent = false;
        _newValue = 0m;
        _newGst = true;
    }

    private void RemoveRow(SchemeChargeTemplate row) => _rows.Remove(row);

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Templates are copied into files by value, so replacing this scheme's set wholesale is safe
        // and simplest — no application row depends on a template row's identity.
        var existing = await db.SchemeChargeTemplates.Where(t => t.Scheme == _scheme).ToListAsync();
        db.SchemeChargeTemplates.RemoveRange(existing);

        foreach (var r in _rows)
        {
            var head = r.Head.Trim();
            if (head.Length == 0) { continue; }
            db.SchemeChargeTemplates.Add(new SchemeChargeTemplate
            {
                CompanyId = CompanyId, Scheme = _scheme, Head = head,
                IsPercent = r.IsPercent, Value = r.Value, GstApplicable = r.GstApplicable,
            });
        }

        await db.SaveChangesAsync();
        await LoadRowsAsync();
        await OnSaved.InvokeAsync($"Saved charges for {_scheme} — new files on this scheme use them");
    }
}
