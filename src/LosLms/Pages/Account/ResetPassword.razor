@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@using LosLms.Services
@attribute [AllowAnonymous]
@inject AccountEmailService AccountEmail
@inject NavigationManager Navigation

<PageTitle>Reset password · LOS/LMS</PageTitle>

<RequireStaticRender />

@* The emailed link lands here. The token is only checked when the form is posted: a tampered, used or expired one gets
   one plain message. The password rules are Identity's own; on success every old session ends (the security stamp
   rotates) and the user signs in with the new password. *@

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-system">LOS/LMS</span>
            <h1 class="auth-title">Choose a new password</h1>
        </div>

        @if (_tokenProblem)
        {
            <p class="inline-error" role="alert">@_error</p>
            <a class="auth-submit" href="/account/forgot-password">Send me a new link</a>
            <a class="auth-secondary" href="/account/login">Back to sign in</a>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
                <DataAnnotationsValidator />

                @if (_error is not null)
                {
                    <p class="inline-error" role="alert">@_error</p>
                }

                <input type="hidden" name="userId" value="@UserId" />
                <input type="hidden" name="code" value="@Code" />

                <div class="auth-field">
                    <label class="auth-label" for="rp-new">New password</label>
                    <div class="auth-password">
                        <InputText id="rp-new" type="password" class="field-input" @bind-Value="Input.NewPassword" autocomplete="new-password" />
                        <PasswordReveal TargetId="rp-new" />
                    </div>
                    <ValidationMessage For="() => Input.NewPassword" class="auth-validation" />
                    <span class="auth-hint">At least 10 characters, with an upper case letter, a lower case letter, a digit and a symbol.</span>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="rp-confirm">Confirm new password</label>
                    <div class="auth-password">
                        <InputText id="rp-confirm" type="password" class="field-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                        <PasswordReveal TargetId="rp-confirm" />
                    </div>
                    <ValidationMessage For="() => Input.ConfirmPassword" class="auth-validation" />
                </div>

                <button type="submit" class="auth-submit">Set new password</button>
            </EditForm>
        }
    </div>
</div>

<script src="js/auth.js"></script>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private ResetInput Input { get; set; } = new();

    // From the link on the first load; from the hidden fields when the form is posted.
    private string? UserId { get; set; }

    private string? Code { get; set; }

    private string? _error;
    private bool _tokenProblem;

    protected override void OnInitialized()
    {
        var source = HttpContext.Request.HasFormContentType ? (IEnumerable<KeyValuePair<string, Microsoft.Extensions.Primitives.StringValues>>)HttpContext.Request.Form
                                                              : HttpContext.Request.Query;
        UserId = source.FirstOrDefault(p => p.Key == "userId").Value.ToString();
        Code = source.FirstOrDefault(p => p.Key == "code").Value.ToString();
        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code))
        {
            _tokenProblem = true;
            _error = "This link is invalid or has expired. Ask for a new one.";
        }
    }

    private async Task ResetAsync()
    {
        var result = await AccountEmail.ResetPasswordAsync(UserId, Code, Input.NewPassword);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/account/login?notice=reset", forceLoad: true);
            return;
        }

        _error = string.Join(" ", result.Errors.Select(e => e.Description));
        _tokenProblem = result.Errors.Any(e => e.Code == "InvalidToken");
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = 10, ErrorMessage = "Use at least 10 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
