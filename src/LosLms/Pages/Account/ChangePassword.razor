@page "/account/change-password"
@using LosLms.Models
@using LosLms.Services
@using Microsoft.AspNetCore.Identity
@* Only admins may change their own password. Staff passwords are set and managed by an admin in
   User Management — staff never change their own, so all credential control sits with the admin. *@
@attribute [Authorize(Roles = TenantContext.AdminRoles)]
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject PasswordVault Vault
@inject Microsoft.Extensions.Options.IOptions<GoogleLoginOptions> Google

<PageTitle>Change password · LOS/LMS</PageTitle>

<RequireStaticRender />

@* Seeded accounts are created on a generated temporary credential and cannot go anywhere else until
   they replace it — see ApplicationUser.MustChangePassword. Identity ships no such mechanism of its
   own, so this page plus the guard in MainLayout is the whole of it.

   This is NOT a password reset flow: it requires the current password, sends no email and issues no
   token. Resetting a forgotten password is deliberately out of scope for this pass. *@

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-system">LOS/LMS</span>
            <h1 class="auth-title">Change your password</h1>
            <p class="auth-sub">
                @if (_mustChange)
                {
                    <text>Your account was created with a temporary password. Choose a new one to continue.</text>
                }
                else
                {
                    <text>Choose a new password for your account.</text>
                }
            </p>
        </div>

        <EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <p class="inline-error" role="alert">@_error</p>
            }

            <div class="auth-field">
                <label class="auth-label" for="cp-current">Current password</label>
                <div class="auth-password">
                    <InputText id="cp-current" type="password" class="field-input"
                               @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
                    <PasswordReveal TargetId="cp-current" />
                </div>
                <ValidationMessage For="() => Input.CurrentPassword" class="auth-validation" />
            </div>

            <div class="auth-field">
                <label class="auth-label" for="cp-new">New password</label>
                <div class="auth-password">
                    <InputText id="cp-new" type="password" class="field-input"
                               @bind-Value="Input.NewPassword" autocomplete="new-password" />
                    <PasswordReveal TargetId="cp-new" />
                </div>
                <ValidationMessage For="() => Input.NewPassword" class="auth-validation" />
                <span class="auth-hint">At least 10 characters, with an upper case letter, a lower case letter, a digit and a symbol.</span>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="cp-confirm">Confirm new password</label>
                <div class="auth-password">
                    <InputText id="cp-confirm" type="password" class="field-input"
                               @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                    <PasswordReveal TargetId="cp-confirm" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" class="auth-validation" />
            </div>

            <button type="submit" class="auth-submit">Change password</button>
        </EditForm>

        @if (Google.Value.Enabled && !_mustChange)
        {
            <div class="auth-or"><span>Google</span></div>
            @if (Notice == "google-linked")
            {
                <p class="auth-notice" role="status">Your Google account is linked. You can now sign in with Google.</p>
            }
            else if (Notice == "google-link-failed")
            {
                <p class="inline-error" role="alert">That Google account could not be linked. It must use the same email address as this user (@_email) and Google must have verified it.</p>
            }

            @if (_googleLinked)
            {
                <p class="auth-hint">Google account linked for @_email.</p>
            }
            else
            {
                <a class="auth-google" href="/account/external/google?intent=link">
                    <span>Link Google account</span>
                </a>
                <span class="auth-hint">Links the Google account for @_email so you can sign in with one click.</span>
            }
        }
    </div>
</div>

<script src="js/auth.js"></script>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private ChangePasswordInput Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "notice")] private string? Notice { get; set; }

    private string? _error;
    private bool _mustChange;
    private bool _googleLinked;
    private string? _email;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        _mustChange = user?.MustChangePassword ?? false;
        _email = user?.Email;
        _googleLinked = user is not null && (await UserManager.GetLoginsAsync(user)).Any(l => l.LoginProvider == GoogleLoginOptions.Provider);
    }

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);

        // Keep the admin's own password viewable in User Management.
        Vault.Store(user.Id, Input.NewPassword);

        // Reissues the cookie so the must-change claim goes away; without this the guard in
        // MainLayout would keep sending the user straight back here.
        await SignInManager.RefreshSignInAsync(user);

        Navigation.NavigateTo("/applications", forceLoad: true);
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = 10, ErrorMessage = "Use at least 10 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
