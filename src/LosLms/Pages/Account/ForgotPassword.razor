@page "/account/forgot-password"
@using System.ComponentModel.DataAnnotations
@using LosLms.Services
@attribute [AllowAnonymous]
@inject AccountEmailService AccountEmail
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Forgot password · LOS/LMS</PageTitle>

<RequireStaticRender />

@* Same reply for a known and an unknown address (no account enumeration). The POST is rate-limited per IP by the
   sign-in limiter in Program.cs, and each address can be mailed at most 3 times an hour. *@

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-system">LOS/LMS</span>
            <h1 class="auth-title">Forgot your password?</h1>
            <p class="auth-sub">Enter your email and we'll send you a link to choose a new one.</p>
        </div>

        @if (_sent)
        {
            <p class="auth-notice" role="status">If that account exists, we've sent a link to reset the password. It works for 24 hours.</p>
            <a class="auth-secondary" href="/account/login">Back to sign in</a>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password">
                <DataAnnotationsValidator />
                <div class="auth-field">
                    <label class="auth-label" for="fp-email">Your email</label>
                    <InputText id="fp-email" type="email" class="field-input" @bind-Value="Input.Email" autocomplete="username" />
                    <ValidationMessage For="() => Input.Email" class="auth-validation" />
                </div>
                <button type="submit" class="auth-submit">Send the link</button>
            </EditForm>
            <a class="auth-secondary" href="/account/login">Back to sign in</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromForm] private EmailInput Input { get; set; } = new();

    private bool _sent;

    private async Task SendAsync()
    {
        await AccountEmail.RequestPasswordResetAsync(Input.Email, AccountLinks.BaseUrl(Config, HttpContextAccessor.HttpContext?.Request));
        _sent = true;
    }

    private sealed class EmailInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
