@* Eye toggle for a password field on the statically rendered /account pages (Login, Setup, Change
   password). The click is wired in auth.js with addEventListener (keyed off data-reveal-target), NOT
   an inline onclick — that keeps the strict Content-Security-Policy (script-src 'self') intact. The
   browser's own reveal control is hidden in CSS (input[type=password]::-ms-reveal) so only this eye
   shows. *@
<button type="button" class="auth-reveal" data-reveal-target="@TargetId"
        aria-label="Show password" aria-pressed="false">
    <svg class="reveal-eye" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
        <circle cx="12" cy="12" r="3" />
    </svg>
    <svg class="reveal-eye-off" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.9 17.9A10.1 10.1 0 0 1 12 20C5 20 1 12 1 12a18.5 18.5 0 0 1 5.1-5.9m3.8-1.9A9.1 9.1 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.2 3.2M9.9 9.9a3 3 0 1 0 4.2 4.2" />
        <line x1="1" y1="1" x2="23" y2="23" />
    </svg>
</button>

@code {
    [Parameter, EditorRequired] public string TargetId { get; set; } = "";
}
