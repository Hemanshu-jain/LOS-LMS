<Project Sdk="Microsoft.NET.Sdk">

  <!-- The single LOS/LMS executable. On first run it asks whether this computer is the host or a staff
       client, then runs that role: the host sets up a bundled portable MySQL (localhost only), starts
       the backend, opens a Cloudflare Quick Tunnel and publishes its URL, and shows the app locally; a
       client just finds the host and connects. Published single-file, so the extracted folder is one
       clean exe rather than a pile of DLLs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LOS-LMS</AssemblyName>
    <RootNamespace>LosLms.Server</RootNamespace>
    <Version>1.1.4</Version>
    <!-- The product logo as the exe's file icon in Explorer. The window/tray icon is read from the exe
         itself at runtime, so no separate app.ico file is shipped (keeps the folder clean). -->
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <!-- Keep the single-file publish output to just the exe: no .pdb, no NuGet .xml doc files. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LosLms.Shell\LosLms.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the real "is MySQL actually accepting connections" readiness poll and the first-run
         bootstrap DDL (create database + application user). -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
